---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroBlueprint from '../components/HeroBlueprint.astro';
import PropertyCard from '../components/PropertyCard.astro';
import RunningHead from '../components/RunningHead.astro';

// General overview video (drone flyover, etc.) — set once available.
// Accepts either a local file path (served natively) or a YouTube/Vimeo URL
// (embedded via iframe). Leave empty to hide this section entirely.
const videoUrl = '/properties/landview.mp4';
const isEmbed = /youtube\.com|youtu\.be|vimeo\.com/.test(videoUrl);

const properties = (await getCollection('properties')).sort((a, b) => a.data.order - b.data.order);
const types = [...new Set(properties.map((p) => p.data.type))];
---
<BaseLayout
  title="Available Properties — Signature Crest Builders"
  description="Land currently available through Signature Crest Builders in Greater Accra — registered, litigation-free, and ready to build on."
>
  <HeroBlueprint
    kind="site-plan"
    runningHead={{ code: 'SCBL · P.00', section: 'Available Properties' }}
    title="Land ready to build on, today."
    lede="Every parcel below is registered and litigation-free before it's listed here — the same five checks we publish for anyone buying land in Ghana, applied to our own inventory first."
  />

  {videoUrl && (
    <section class="relative sc-section-tight">
      <div class="sc-container sc-gutter">
        <p class="sc-bracket-label mb-8">The Ground</p>
        <div class="relative aspect-video overflow-hidden border sc-border-accent-firm">
          {isEmbed ? (
            <iframe
              src={videoUrl}
              title="An overview of current Signature Crest land"
              class="absolute inset-0 h-full w-full"
              loading="lazy"
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
              allowfullscreen
            ></iframe>
          ) : (
            <video src={videoUrl} class="h-full w-full object-cover" controls preload="metadata"></video>
          )}
        </div>
      </div>
    </section>
  )}

  <section class="relative sc-section">
    <div class="sc-container sc-gutter">
      <div class="grid grid-cols-12 gap-8 mb-12 md:mb-16">
        <div class="col-span-12 md:col-span-4">
          <p class="sc-bracket-label">Currently Available</p>
        </div>
        <div class="col-span-12 md:col-span-8">
          <h2 class="sc-display-lg sc-text-primary max-w-[24ch]">Enquire directly on any parcel below.</h2>
          <p class="sc-lede sc-text-muted mt-6 max-w-[58ch]">
            Prices shown are current at time of listing. Availability changes as parcels are reserved — confirm status when you enquire.
          </p>
        </div>
      </div>

      {types.length > 1 && (
        <div class="flex flex-wrap gap-3 mb-10" data-property-filters>
          <button type="button" class="sc-chip-active" data-filter="all">All</button>
          {types.map((t) => (
            <button type="button" class="sc-chip-inactive" data-filter={t}>
              {t.charAt(0).toUpperCase() + t.slice(1)}
            </button>
          ))}
        </div>
      )}

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 md:gap-8" data-property-grid>
        {properties.map((p) => (
          <div data-property-type={p.data.type}>
            <PropertyCard
              title={p.data.title}
              slug={p.data.slug}
              location={p.data.location}
              price={p.data.price}
              status={p.data.status}
              summary={p.data.summary}
              hero_image={p.data.hero_image}
              specs={p.data.specs}
            />
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="relative sc-section-tight border-t sc-border-soft">
    <div class="sc-container sc-gutter">
      <RunningHead code="SCBL · P.00" rev="END" section="Continue" />
      <div class="mt-14 grid grid-cols-12 gap-8">
        <div class="col-span-12 md:col-span-8">
          <h2 class="sc-display-lg sc-text-primary max-w-[24ch]">
            Not seeing the right fit? Tell us what you're looking for.
          </h2>
        </div>
        <div class="col-span-12 md:col-span-4 md:pt-8">
          <a href="/contact#form" class="sc-btn-primary">Begin a project</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  function init() {
    const container = document.querySelector<HTMLElement>('[data-property-filters]');
    const cards = document.querySelectorAll<HTMLElement>('[data-property-type]');
    if (!container) return;

    container.querySelectorAll<HTMLButtonElement>('button').forEach((btn) => {
      btn.addEventListener('click', () => {
        const filter = btn.dataset.filter ?? 'all';
        container.querySelectorAll<HTMLButtonElement>('button').forEach((b) => {
          b.className = b === btn ? 'sc-chip-active' : 'sc-chip-inactive';
        });
        cards.forEach((card) => {
          const show = filter === 'all' || card.dataset.propertyType === filter;
          card.classList.toggle('hidden', !show);
        });
      });
    });
  }
  init();
  document.addEventListener('astro:after-swap', init);
</script>
