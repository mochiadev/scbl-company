---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Reveal from '../../components/Reveal.astro';
import MeshGlow from '../../components/MeshGlow.astro';
import GridlineFrame from '../../components/GridlineFrame.astro';
import SpecBlock from '../../components/SpecBlock.astro';
import { pillarBySlug } from '../../lib/pillars.ts';

export async function getStaticPaths() {
  const portfolio = await getCollection('portfolio');
  portfolio.sort((a, b) => b.data.year - a.data.year);
  return portfolio.map((entry, i) => {
    const next = portfolio[(i + 1) % portfolio.length];
    return {
      params: { slug: entry.data.slug },
      props: { entry, next },
    };
  });
}

const { entry, next } = Astro.props;
const { Content } = await render(entry);

const specEntries = [
  entry.data.specs.gfa ? { label: 'GFA', value: entry.data.specs.gfa } : null,
  entry.data.specs.concrete_grade ? { label: 'Concrete', value: entry.data.specs.concrete_grade } : null,
  entry.data.specs.breeam ? { label: 'BREEAM', value: entry.data.specs.breeam } : null,
  entry.data.specs.mep_scope ? { label: 'MEP', value: entry.data.specs.mep_scope } : null,
  { label: 'Location', value: entry.data.location },
  { label: 'Year', value: String(entry.data.year) },
].filter(Boolean) as { label: string; value: string }[];

const pillarLabels = entry.data.pillars.map((p) => pillarBySlug.get(p as any)?.title ?? p);
---
<BaseLayout
  title={`${entry.data.title} — Signature Crest`}
  description={`${entry.data.title} — ${entry.data.location}, ${entry.data.year}. A Signature Crest project cross-tagging ${pillarLabels.join(', ')}.`}
>
  <!-- Hero -->
  <section class="relative isolate overflow-hidden px-6 pt-32 pb-16 md:px-10 md:pt-40 md:pb-24">
    <MeshGlow position="top-left" size="xl" intensity={0.14} />
    <div class="mx-auto max-w-[1440px]" data-reveal-group>
      <Reveal>
        <p class="tabular text-xs sc-text-accent">{pillarLabels.join(' · ')}</p>
      </Reveal>
      <Reveal>
        <h1 class="mt-6 max-w-5xl font-display text-[clamp(2.75rem,7vw,6.5rem)] leading-[0.98] tracking-tight sc-text-primary">
          {entry.data.title}
        </h1>
      </Reveal>
      <Reveal>
        <p class="mt-6 tabular text-sm sc-text-muted">
          {entry.data.location} — {entry.data.year}
        </p>
      </Reveal>
    </div>
  </section>

  <!-- Hero image -->
  <section class="relative isolate px-6 md:px-10">
    <div class="mx-auto max-w-[1600px]" data-reveal-group>
      <Reveal>
        <div class="relative aspect-[16/9] overflow-hidden">
          <Image
            src={entry.data.hero_image}
            alt={`${entry.data.title} — hero photograph`}
            width={2400}
            height={1350}
            widths={[900, 1400, 1800, 2400]}
            sizes="(min-width: 1024px) 90vw, 100vw"
            class="h-full w-full object-cover"
            loading="eager"
            format="webp"
          />
        </div>
      </Reveal>
    </div>
  </section>

  <!-- Narrative + spec -->
  <section class="relative isolate px-6 py-24 md:px-10 md:py-32">
    <GridlineFrame tone="dark" columns={12} />
    <div class="relative mx-auto grid max-w-[1440px] gap-16 md:grid-cols-12" data-reveal-group>
      <div class="md:col-span-7 md:col-start-2 space-y-6 text-lg leading-relaxed sc-text-secondary">
        <Reveal>
          <Content />
        </Reveal>
      </div>
      <div class="md:col-span-4">
        <Reveal>
          <SpecBlock specs={specEntries} />
        </Reveal>
      </div>
    </div>
  </section>

  <!-- Gallery -->
  {entry.data.gallery && entry.data.gallery.length > 0 && (
    <section class="relative isolate sc-bg-ivory px-6 py-24 md:px-10 md:py-32">
      <div class="mx-auto max-w-[1440px]" data-reveal-group>
        <Reveal>
          <p class="tabular text-xs sc-text-accent-subdued">Gallery</p>
          <h2 class="mt-4 font-display text-3xl leading-tight tracking-tight sc-text-primary-light md:text-5xl">
            In the <span class="sc-text-accent-subdued">detail</span>.
          </h2>
        </Reveal>
        <div class="mt-16 grid gap-6 md:grid-cols-12">
          {entry.data.gallery.map((src, i) => {
            const span = i === 0 ? 'md:col-span-8' : i === 1 ? 'md:col-span-4' : 'md:col-span-6';
            const aspect = i === 0 ? 'aspect-[16/10]' : i === 1 ? 'aspect-[4/5]' : 'aspect-[3/2]';
            return (
              <Reveal>
                <div class={`relative overflow-hidden ${span} ${aspect}`}>
                  <Image
                    src={src}
                    alt={`${entry.data.title} — image ${i + 1}`}
                    width={1600}
                    height={1000}
                    widths={[600, 900, 1200, 1600]}
                    sizes="(min-width: 768px) 60vw, 100vw"
                    class="h-full w-full object-cover"
                    format="webp"
                  />
                </div>
              </Reveal>
            );
          })}
        </div>
      </div>
    </section>
  )}

  <!-- Next -->
  <section class="relative isolate border-t sc-border-soft px-6 py-16 md:px-10 md:py-20">
    <div class="mx-auto flex max-w-[1440px] items-end justify-between">
      <div>
        <p class="tabular text-xs sc-text-accent-subdued">Next project</p>
        <p class="mt-2 font-display text-3xl sc-text-primary md:text-4xl">{next.data.title}</p>
      </div>
      <a href={`/portfolio/${next.data.slug}`} class="group sc-link-accent inline-flex items-center gap-3">
        <span class="hidden md:inline text-sm tracking-widest uppercase">Continue</span>
        <Icon name="lucide:arrow-right" class="h-6 w-6 transition-transform group-hover:translate-x-1" />
      </a>
    </div>
  </section>
</BaseLayout>
