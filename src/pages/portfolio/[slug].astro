---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import RunningHead from '../../components/RunningHead.astro';
import SpecBlock from '../../components/SpecBlock.astro';
import Reveal from '../../components/Reveal.astro';
import { pillarBySlug } from '../../lib/pillars.ts';

export async function getStaticPaths() {
  const portfolio = await getCollection('portfolio');
  portfolio.sort((a, b) => b.data.year - a.data.year);
  return portfolio.map((entry, i) => {
    const next = portfolio[(i + 1) % portfolio.length];
    return {
      params: { slug: entry.data.slug },
      props: { entry, next, index: i + 1 },
    };
  });
}

const { entry, next, index } = Astro.props;
const { Content } = await render(entry);

const specEntries = [
  entry.data.specs.gfa            ? { label: 'GFA',       value: entry.data.specs.gfa } : null,
  entry.data.specs.concrete_grade ? { label: 'Concrete',  value: entry.data.specs.concrete_grade } : null,
  entry.data.specs.breeam         ? { label: 'BREEAM',    value: entry.data.specs.breeam } : null,
  entry.data.specs.mep_scope      ? { label: 'MEP',       value: entry.data.specs.mep_scope } : null,
  { label: 'Location', value: entry.data.location },
  { label: 'Year',     value: String(entry.data.year) },
].filter(Boolean) as { label: string; value: string }[];

const pillarLabels = entry.data.pillars.map((p) => pillarBySlug.get(p as any)?.title ?? p);
const record = String(index).padStart(2, '0');
---
<BaseLayout
  title={`${entry.data.title} — Signature Crest`}
  description={`${entry.data.title} — ${entry.data.location}, ${entry.data.year}. A cross-pillar project tagging ${pillarLabels.join(', ')}.`}
>
  <!-- Header -->
  <section class="relative sc-section-tight">
    <div class="sc-container sc-gutter pt-12 md:pt-16" data-reveal-group>
      <RunningHead code={`SCBL · P.${record}`} rev="REV 01" section="Portfolio Record" />

      <div class="grid grid-cols-12 gap-8 pt-14">
        <div class="col-span-12 md:col-span-9">
          <Reveal>
            <p class="sc-slug sc-text-accent-subdued">Record {record} — {pillarLabels.join(' · ')}</p>
          </Reveal>
          <Reveal>
            <h1 class="sc-display-xl sc-text-primary mt-6 max-w-[16ch]">{entry.data.title}</h1>
          </Reveal>
          <Reveal>
            <p class="sc-lede-lg sc-text-secondary mt-6">{entry.data.location} — {entry.data.year}</p>
          </Reveal>
        </div>
      </div>
    </div>
  </section>

  <!-- Hero image -->
  <section class="relative">
    <div class="sc-container sc-gutter">
      <div class="relative aspect-[16/9] overflow-hidden">
        <Image
          src={entry.data.hero_image}
          alt={`${entry.data.title} — hero photograph. ${entry.data.location}, ${entry.data.year}.`}
          width={2400}
          height={1350}
          widths={[900, 1400, 1800, 2400]}
          sizes="(min-width: 1024px) 90vw, 100vw"
          class="h-full w-full object-cover"
          loading="eager"
          format="webp"
        />
      </div>
    </div>
  </section>

  <!-- Narrative + spec -->
  <section class="relative sc-section-tight">
    <div class="sc-container sc-gutter grid grid-cols-12 gap-8 md:gap-12">
      <div class="col-span-12 md:col-span-8 sc-lede sc-text-secondary space-y-5 max-w-[62ch]">
        <Content />
      </div>
      <div class="col-span-12 md:col-span-4">
        <SpecBlock specs={specEntries} />
      </div>
    </div>
  </section>

  <!-- Gallery -->
  {entry.data.gallery && entry.data.gallery.length > 0 && (
    <section class="relative sc-section sc-bg-ivory sc-text-primary-light">
      <div class="sc-container sc-gutter">
        <p class="sc-bracket-label sc-text-accent-subdued">Gallery</p>
        <h2 class="sc-heading-lg mt-4">In the detail.</h2>

        <div class="mt-12 grid grid-cols-12 gap-4 md:gap-6">
          {entry.data.gallery.map((src, i) => {
            const span = i === 0 ? 'col-span-12 md:col-span-8' : i === 1 ? 'col-span-12 md:col-span-4' : 'col-span-12 md:col-span-6';
            const aspect = i === 0 ? 'aspect-[16/10]' : i === 1 ? 'aspect-[4/5]' : 'aspect-[3/2]';
            return (
              <div class:list={['relative overflow-hidden', span, aspect]}>
                <Image
                  src={src}
                  alt={`${entry.data.title} — gallery image ${i + 1} of ${entry.data.gallery.length}.`}
                  width={1600}
                  height={1000}
                  widths={[600, 900, 1200, 1600]}
                  sizes="(min-width: 768px) 60vw, 100vw"
                  class="h-full w-full object-cover"
                  format="webp"
                />
              </div>
            );
          })}
        </div>
      </div>
    </section>
  )}

  <!-- Next -->
  <section class="relative border-t sc-border-soft">
    <div class="sc-container sc-gutter py-12 md:py-14">
      <div class="grid grid-cols-12 items-end gap-6">
        <div class="col-span-8">
          <p class="sc-slug sc-text-accent-subdued">Next record</p>
          <p class="sc-heading-md sc-text-primary mt-2">{next.data.title}</p>
        </div>
        <div class="col-span-4 text-right">
          <a href={`/portfolio/${next.data.slug}`} class="sc-link sc-small sc-text-accent">Continue</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
