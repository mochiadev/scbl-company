---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/Hero.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { pillars } from '../../lib/pillars.ts';

const portfolio = await getCollection('portfolio');
portfolio.sort((a, b) => b.data.year - a.data.year);
---
<BaseLayout
  title="Portfolio — Signature Crest Builders"
  description="A record of premium residential, mixed-use, and heritage projects delivered by Signature Crest Builders — in Accra and across Ghana."
>
  <Hero
    runningHead={{ code: 'SCBL · P.00', rev: 'REV 01', section: 'Portfolio Record' }}
    title="Selected work — the record."
    lede="A working sample of what the practice has delivered — private residences, mixed-use civic quarters, and heritage restoration. Every project is cross-pillar; filter to see how the practice fits together."
    variant="quiet"
  />

  <section class="relative sc-section-tight">
    <div class="sc-container sc-gutter">
      <div class="flex flex-wrap items-center gap-2 mb-14" data-sc-filter-controls>
        <p class="sc-slug sc-text-accent-subdued mr-3">Filter by pillar</p>
        <button
          type="button"
          class="sc-chip-active px-4 py-2 sc-caption"
          data-filter="all"
          aria-pressed="true"
        >All</button>
        {pillars.map((p) => (
          <button
            type="button"
            class="sc-chip-inactive px-4 py-2 sc-caption"
            data-filter={p.slug}
            aria-pressed="false"
          >
            {p.title.replace(' Services', '').replace('Property ', '').replace('Project & Construction ', '')}
          </button>
        ))}
      </div>

      <div class="flex flex-col gap-14 md:gap-16" data-sc-portfolio-grid>
        {portfolio.map((project, i) => (
          <div data-project data-pillars={project.data.pillars.join(',')}>
            <ProjectCard
              index={i + 1}
              title={project.data.title}
              slug={project.data.slug}
              location={project.data.location}
              year={project.data.year}
              pillars={project.data.pillars}
              image={project.data.hero_image}
              variant="index"
              aspect={i % 2 === 0 ? 'landscape' : 'portrait'}
            />
          </div>
        ))}
      </div>
    </div>
  </section>

  <script>
    const buttons = document.querySelectorAll<HTMLButtonElement>('[data-sc-filter-controls] button[data-filter]');
    const items = document.querySelectorAll<HTMLElement>('[data-project]');

    function applyFilter(value: string) {
      items.forEach((item) => {
        const list = (item.dataset.pillars ?? '').split(',');
        item.style.display = value === 'all' || list.includes(value) ? '' : 'none';
      });
      buttons.forEach((btn) => {
        const active = btn.dataset.filter === value;
        btn.setAttribute('aria-pressed', String(active));
        btn.classList.toggle('sc-chip-active', active);
        btn.classList.toggle('sc-chip-inactive', !active);
      });
    }

    buttons.forEach((btn) => btn.addEventListener('click', () => applyFilter(btn.dataset.filter ?? 'all')));
  </script>
</BaseLayout>
