---
import { getCollection, render } from 'astro:content';
import { Icon } from 'astro-icon/components';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Reveal from '../../components/Reveal.astro';
import MeshGlow from '../../components/MeshGlow.astro';
import { pillarBySlug } from '../../lib/pillars.ts';

export async function getStaticPaths() {
  const insights = await getCollection('insights');
  insights.sort((a, b) => b.data.published.getTime() - a.data.published.getTime());
  return insights.map((entry, i) => {
    const next = insights[(i + 1) % insights.length];
    return { params: { slug: entry.data.slug }, props: { entry, next } };
  });
}

const { entry, next } = Astro.props;
const { Content } = await render(entry);
const pillarMeta = pillarBySlug.get(entry.data.pillar as any);
const dateStr = entry.data.published.toLocaleDateString('en-GB', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});
---
<BaseLayout
  title={`${entry.data.title} — Signature Crest`}
  description={entry.data.excerpt}
>
  <article class="relative isolate">
    <!-- Header -->
    <header class="relative isolate overflow-hidden px-6 pt-32 pb-16 md:px-10 md:pt-48 md:pb-24">
      <MeshGlow position="top-right" size="lg" intensity={0.12} />
      <div class="relative mx-auto max-w-3xl" data-reveal-group>
        <Reveal>
          <p class="tabular text-xs sc-text-accent">
            {pillarMeta?.title ?? entry.data.pillar} · {entry.data.reading_time} min · {dateStr}
          </p>
        </Reveal>
        <Reveal>
          <h1 class="mt-6 font-display text-[clamp(2.5rem,5vw,4.5rem)] leading-[1.02] tracking-tight sc-text-primary">
            {entry.data.title}
          </h1>
        </Reveal>
        <Reveal>
          <p class="mt-8 text-lg leading-relaxed sc-text-muted md:text-xl">
            {entry.data.excerpt}
          </p>
        </Reveal>
      </div>
    </header>

    <!-- Body -->
    <section class="relative isolate px-6 py-16 md:px-10 md:py-24">
      <div class="mx-auto max-w-2xl text-lg leading-[1.75] sc-text-secondary sc-article" data-reveal-group>
        <Content />
      </div>
    </section>
  </article>

  <!-- Next -->
  <section class="relative isolate border-t sc-border-soft px-6 py-16 md:px-10 md:py-20">
    <div class="mx-auto flex max-w-[1440px] items-end justify-between">
      <div>
        <p class="tabular text-xs sc-text-accent-subdued">Next essay</p>
        <p class="mt-2 font-display text-3xl sc-text-primary md:text-4xl">{next.data.title}</p>
      </div>
      <a href={`/insights/${next.data.slug}`} class="group sc-link-accent inline-flex items-center gap-3">
        <span class="hidden md:inline text-sm tracking-widest uppercase">Read next</span>
        <Icon name="lucide:arrow-right" class="h-6 w-6 transition-transform group-hover:translate-x-1" />
      </a>
    </div>
  </section>
</BaseLayout>

<style is:global>
  .sc-article h2 {
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 3vw, 2.5rem);
    line-height: 1.15;
    letter-spacing: -0.02em;
    color: var(--sc-text-accent);
    margin-top: 3rem;
    margin-bottom: 1.5rem;
  }
  .sc-article h3 {
    font-family: var(--font-display);
    font-size: 1.5rem;
    color: var(--sc-text-primary-on-dark);
    margin-top: 2rem;
    margin-bottom: 1rem;
  }
  .sc-article p { margin-bottom: 1.25rem; }
  .sc-article ul { list-style: none; padding-left: 0; margin: 1.5rem 0; }
  .sc-article ul li { padding-left: 1.5rem; position: relative; margin-bottom: 0.75rem; }
  .sc-article ul li::before {
    content: "";
    position: absolute;
    left: 0; top: 0.85em;
    width: 0.75rem; height: 1px;
    background: var(--sc-text-accent-subdued);
  }
  .sc-article strong { color: var(--sc-text-primary-on-dark); font-weight: 500; }
</style>
