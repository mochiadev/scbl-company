---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import RunningHead from '../../components/RunningHead.astro';
import MeshGlow from '../../components/MeshGlow.astro';
import Reveal from '../../components/Reveal.astro';
import { pillarBySlug } from '../../lib/pillars.ts';

export async function getStaticPaths() {
  const insights = await getCollection('insights');
  insights.sort((a, b) => b.data.published.getTime() - a.data.published.getTime());
  return insights.map((entry, i) => {
    const next = insights[(i + 1) % insights.length];
    return { params: { slug: entry.data.slug }, props: { entry, next } };
  });
}

const { entry, next } = Astro.props;
const { Content } = await render(entry);
const pillarMeta = pillarBySlug.get(entry.data.pillar as any);
const dateStr = entry.data.published.toLocaleDateString('en-GB', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});
---
<BaseLayout
  title={`${entry.data.title} — Signature Crest`}
  description={entry.data.excerpt}
>
  <article class="relative">
    <section class="relative sc-section-tight">
      <MeshGlow position="top-right" size="lg" intensity={0.05} />
      <div class="sc-container sc-gutter pt-12 md:pt-16" data-reveal-group>
        <RunningHead code="SCBL" section="Insights" />
        <div class="sc-container-prose mx-auto pt-14 md:pt-20">
          <Reveal>
            <p class="sc-slug sc-text-accent-subdued">
              {pillarMeta?.title ?? entry.data.pillar} · {entry.data.reading_time} min · {dateStr}
            </p>
          </Reveal>
          <Reveal>
            <h1 class="sc-display-lg sc-text-primary mt-6 max-w-[18ch]">
              {entry.data.title}
            </h1>
          </Reveal>
          <Reveal>
            <p class="sc-lede-lg sc-text-secondary mt-8">
              {entry.data.excerpt}
            </p>
          </Reveal>
        </div>
      </div>
    </section>

    <!-- Hero image -->
    <section class="relative">
      <div class="sc-container sc-gutter">
        <div class="relative aspect-[16/9] overflow-hidden">
          <Image
            src={entry.data.hero_image}
            alt={entry.data.hero_image_alt ?? entry.data.title}
            width={2400}
            height={1350}
            widths={[900, 1400, 1800, 2400]}
            sizes="(min-width: 1024px) 90vw, 100vw"
            class="h-full w-full object-cover"
            loading="eager"
            format="webp"
          />
        </div>
      </div>
    </section>

    <section class="relative sc-section-tight">
      <div class="sc-container sc-gutter">
        <div class="sc-container-prose mx-auto sc-lede sc-text-secondary sc-article">
          <Content />
        </div>

        <div class="sc-container-prose mx-auto mt-4">
          <div class="border sc-border-firm p-6 md:p-8">
            <p class="sc-bracket-label mb-3">Continue the conversation</p>
            <p class="sc-lede sc-text-secondary max-w-[52ch]">
              {entry.data.cta_hook ?? 'If this note is relevant to a project you\'re weighing, we\'re glad to talk it through.'}
            </p>
            <div class="mt-6 flex flex-wrap items-center gap-x-8 gap-y-3">
              <a href="/contact#form" class="sc-btn-secondary">Begin a project</a>
              <p class="sc-small sc-text-muted">
                Or call <a href="tel:+233500903792" class="sc-link sc-text-accent">+233 500 903 792</a>
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>
  </article>

  <section class="relative border-t sc-border-soft">
    <div class="sc-container sc-gutter py-12 md:py-14">
      <div class="grid grid-cols-12 items-end gap-6">
        <div class="col-span-8">
          <p class="sc-slug sc-text-accent-subdued">Next note</p>
          <p class="sc-heading-md sc-text-primary mt-2">{next.data.title}</p>
        </div>
        <div class="col-span-4 text-right">
          <a href={`/insights/${next.data.slug}`} class="sc-link sc-small sc-text-accent">Read next</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style is:global>
  .sc-article h2 {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 2.4vw, 2rem);
    line-height: 1.2;
    letter-spacing: -0.015em;
    color: var(--sc-text-accent);
    margin-top: 2.5rem;
    margin-bottom: 1rem;
    font-variation-settings: "opsz" 36;
  }
  .sc-article h3 {
    font-family: var(--font-display);
    font-size: 1.25rem;
    color: var(--sc-text-primary-on-dark);
    margin-top: 2rem;
    margin-bottom: 0.75rem;
  }
  .sc-article p { margin-bottom: 1.15rem; }
  .sc-article ul { list-style: none; padding-left: 0; margin: 1.25rem 0; }
  .sc-article ul li { padding-left: 1.25rem; position: relative; margin-bottom: 0.65rem; }
  .sc-article ul li::before {
    content: "";
    position: absolute;
    left: 0; top: 0.85em;
    width: 0.75rem; height: 1px;
    background: var(--sc-text-accent-subdued);
  }
  .sc-article strong { color: var(--sc-text-primary-on-dark); font-weight: 500; }
</style>
