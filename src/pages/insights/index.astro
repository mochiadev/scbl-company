---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import HeroBlueprint from '../../components/HeroBlueprint.astro';
import InsightCard from '../../components/InsightCard.astro';

const insights = await getCollection('insights');
insights.sort((a, b) => b.data.published.getTime() - a.data.published.getTime());
---
<BaseLayout
  title="Insights — Signature Crest Builders"
  description="Our blog — insights on underwriting, engineering, and building in Ghana, written by the SCBL team."
>
  <HeroBlueprint
    kind="axonometric"
    runningHead={{ code: 'SCBL', section: 'Insights' }}
    title="Insights from the practice."
    lede="Investment underwriting, engineering methodology, and long-form thinking on the built environment — written by the people doing the work."
    detailImage="/hero/engineer.webp"
    detailImageAlt="Two engineers reading a set of drawings on site."
    detailCaption="On site · reading the drawings"
  />

  <section class="relative sc-section-tight">
    <div class="sc-container sc-gutter">
      <div>
        {insights.map((post) => (
          <InsightCard
            title={post.data.title}
            slug={post.data.slug}
            pillar={post.data.pillar}
            published={post.data.published}
            reading_time={post.data.reading_time}
            excerpt={post.data.excerpt}
            variant="row"
          />
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
