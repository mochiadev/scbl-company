---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/Hero.astro';
import InsightCard from '../../components/InsightCard.astro';

const insights = await getCollection('insights');
insights.sort((a, b) => b.data.published.getTime() - a.data.published.getTime());
---
<BaseLayout
  title="Insights — Signature Crest Builders"
  description="Field notes from the practice — underwriting, engineering methodology, and long-form thinking on the built environment, written by the people doing the work."
>
  <Hero
    runningHead={{ code: 'SCBL · I.00', rev: 'REV 01', section: 'Field Notes' }}
    title="Field notes from the practice."
    lede="Investment underwriting, engineering methodology, and long-form thinking on the built environment — written by the people doing the work."
    variant="quiet"
  />

  <section class="relative sc-section-tight">
    <div class="sc-container sc-gutter">
      <div>
        {insights.map((post) => (
          <InsightCard
            title={post.data.title}
            slug={post.data.slug}
            pillar={post.data.pillar}
            published={post.data.published}
            reading_time={post.data.reading_time}
            excerpt={post.data.excerpt}
            variant="row"
          />
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
