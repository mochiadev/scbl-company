---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import RunningHead from '../../components/RunningHead.astro';
import MeshGlow from '../../components/MeshGlow.astro';
import SpecBlock from '../../components/SpecBlock.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import Reveal from '../../components/Reveal.astro';
import { pillars, pillarBySlug } from '../../lib/pillars.ts';

export async function getStaticPaths() {
  const services = await getCollection('services');
  return services.map((entry) => ({
    params: { pillar: entry.id.replace(/\.md$/, '') },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const slug = entry.id.replace(/\.md$/, '') as any;
const meta = pillarBySlug.get(slug);
const { Content } = await render(entry);

const currentIndex = pillars.findIndex((p) => p.slug === slug);
const next = pillars[(currentIndex + 1) % pillars.length];

const portfolio = await getCollection('portfolio');
const related = portfolio.filter((p) => p.data.pillars.includes(slug)).slice(0, 2);

const ordinal = String(entry.data.order).padStart(2, '0');
---
<BaseLayout
  title={`${entry.data.title} — Signature Crest`}
  description={`Signature Crest ${entry.data.title.toLowerCase()}: ${entry.data.sub_services.slice(0, 3).join(', ').toLowerCase()}, and more. Delivered end-to-end from one accountable practice in Accra.`}
>
  <!-- Hero -->
  <section class="relative isolate overflow-hidden">
    <MeshGlow position="top-right" size="xl" intensity={0.10} />
    <div class="absolute inset-0 -z-10">
      <Image
        src={entry.data.hero_image}
        alt={`${entry.data.title} — a working scene from the practice.`}
        width={2400}
        height={1400}
        widths={[720, 1200, 1800, 2400]}
        sizes="100vw"
        class="h-full w-full object-cover opacity-30"
        loading="eager"
        format="webp"
      />
      <div class="absolute inset-0 sc-overlay-scrim"></div>
    </div>

    <div class="sc-container sc-gutter pt-28 md:pt-36">
      <RunningHead code={`SCBL · S.${ordinal}`} rev="REV 01" section={entry.data.title} />
    </div>

    <div class="sc-container sc-gutter grid grid-cols-12 gap-8 pt-16 md:pt-20 pb-20 md:pb-24" data-reveal-group>
      <div class="col-span-12 md:col-span-9">
        <Reveal>
          <p class="sc-slug sc-text-accent-subdued">Pillar {ordinal} — {entry.data.title.replace('Services', '').replace('Property ', '').trim()}</p>
        </Reveal>
        <Reveal>
          <h1 class="sc-display-xl sc-text-primary mt-6 max-w-[16ch]">{entry.data.title}</h1>
        </Reveal>
        {meta && (
          <Reveal>
            <p class="sc-lede-lg sc-text-secondary mt-8 max-w-[52ch]">{meta.short}</p>
          </Reveal>
        )}
      </div>
    </div>
  </section>

  <!-- Sub-services -->
  <section class="relative sc-section-tight">
    <div class="sc-container sc-gutter grid grid-cols-12 gap-8 md:gap-12">
      <div class="col-span-12 md:col-span-4">
        <p class="sc-bracket-label">Capabilities</p>
        <h2 class="sc-heading-lg sc-text-primary mt-4 max-w-[18ch]">What we do inside this pillar.</h2>
      </div>
      <div class="col-span-12 md:col-span-8">
        <ul class="border-t sc-border-hairline">
          {entry.data.sub_services.map((s) => (
            <li class="border-b sc-border-hairline py-4 md:py-5">
              <p class="sc-body sc-text-primary">{s}</p>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- Narrative + spec -->
  <section class="relative sc-section sc-bg-ivory sc-text-primary-light">
    <div class="sc-container sc-gutter grid grid-cols-12 gap-8 md:gap-12">
      <div class="col-span-12 md:col-span-8 space-y-5 sc-lede">
        <Content />
      </div>
      <div class="col-span-12 md:col-span-4">
        {entry.data.tech_specs && entry.data.tech_specs.length > 0 && (
          <SpecBlock
            heading="Standards & Methods"
            specs={entry.data.tech_specs.map((v, i) => ({ label: String(i + 1).padStart(2, '0'), value: v }))}
          />
        )}
      </div>
    </div>
  </section>

  <!-- Related projects -->
  {related.length > 0 && (
    <section class="relative sc-section-tight">
      <div class="sc-container sc-gutter">
        <div class="flex items-end justify-between mb-10">
          <div>
            <p class="sc-bracket-label">Selected Work</p>
            <h2 class="sc-heading-lg sc-text-primary mt-4 max-w-[24ch]">
              {entry.data.title} in the field.
            </h2>
          </div>
        </div>
        <div class="flex flex-col gap-14 md:gap-16">
          {related.map((project, i) => (
            <ProjectCard
              index={i + 1}
              title={project.data.title}
              slug={project.data.slug}
              location={project.data.location}
              year={project.data.year}
              pillars={project.data.pillars}
              image={project.data.hero_image}
              variant="index"
              aspect={i === 0 ? 'landscape' : 'portrait'}
            />
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- Next pillar -->
  <section class="relative border-t sc-border-soft">
    <div class="sc-container sc-gutter py-12 md:py-14">
      <div class="grid grid-cols-12 items-end gap-6">
        <div class="col-span-8">
          <p class="sc-slug sc-text-accent-subdued">Next pillar</p>
          <p class="sc-heading-md sc-text-primary mt-2">{next.title}</p>
        </div>
        <div class="col-span-4 text-right">
          <a href={next.href} class="sc-link sc-small sc-text-accent">Continue</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
