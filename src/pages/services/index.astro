---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PillarBento from '../../components/PillarBento.astro';
import Reveal from '../../components/Reveal.astro';
import MeshGlow from '../../components/MeshGlow.astro';
import GridlineFrame from '../../components/GridlineFrame.astro';
import { pillars } from '../../lib/pillars.ts';

const services = await getCollection('services');
services.sort((a, b) => a.data.order - b.data.order);

const bento = pillars.map((p) => {
  const record = services.find((s) => s.id.startsWith(p.slug));
  return {
    ...p,
    subServices: record?.data.sub_services ?? [],
  };
});
---
<BaseLayout
  title="Services — Signature Crest Builders"
  description="Six pillars of practice: property development, construction, engineering, real estate, project management, and specialist services."
>
  <section class="relative isolate overflow-hidden px-6 pt-32 pb-24 md:px-10 md:pt-48 md:pb-32">
    <GridlineFrame tone="dark" columns={12} />
    <MeshGlow position="top-left" size="xl" intensity={0.14} />
    <div class="relative mx-auto max-w-[1440px]" data-reveal-group>
      <Reveal>
        <p class="eyebrow">Suite of Services</p>
      </Reveal>
      <Reveal>
        <h1 class="mt-6 max-w-5xl font-display text-[clamp(2.75rem,7vw,6.5rem)] leading-[0.98] tracking-tight sc-text-primary">
          Six pillars of practice. <br class="hidden md:block" /><span class="sc-text-accent">One accountable roof.</span>
        </h1>
      </Reveal>
      <Reveal>
        <p class="mt-10 max-w-2xl text-lg leading-relaxed sc-text-muted">
          Our integrated model — development, construction, engineering, real estate, project management, and specialist practices — means every project runs on a single line of accountability, one commercial position, and one team paid to hold quality.
        </p>
      </Reveal>
    </div>
  </section>

  <section class="relative isolate px-6 py-24 md:px-10 md:py-32">
    <div class="mx-auto max-w-[1440px]">
      <PillarBento pillars={bento} tone="navy" />
    </div>
  </section>

  <section class="relative isolate sc-bg-ivory px-6 py-24 sc-text-primary-light md:px-10 md:py-32">
    <div class="mx-auto max-w-[1440px]" data-reveal-group>
      <Reveal>
        <p class="tabular text-xs sc-text-accent-subdued">A note on the model</p>
        <p class="mt-6 max-w-3xl font-display text-2xl leading-[1.25] tracking-tight md:text-4xl">
          We do not treat services as separate businesses that occasionally speak. They are one practice, priced together, held accountable together, and answerable to the same senior team.
        </p>
      </Reveal>
    </div>
  </section>
</BaseLayout>
