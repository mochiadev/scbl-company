---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroBlueprint from '../components/HeroBlueprint.astro';
import RunningHead from '../components/RunningHead.astro';
import MeshGlow from '../components/MeshGlow.astro';

const values = [
  { key: 'A', title: 'Integrity',   body: 'Honesty, transparency, and accountability in every relationship and every project.' },
  { key: 'B', title: 'Excellence',  body: 'The highest standards of design, engineering, and craftsmanship — without compromise.' },
  { key: 'C', title: 'Trust',       body: 'Confidence earned and protected through consistent delivery and ethical practice.' },
  { key: 'D', title: 'Legacy',      body: 'Structures designed to endure — assets that hold meaning for generations.' },
  { key: 'E', title: 'Innovation',  body: 'Progressive methods, sustainable practices, and intelligent design.' },
  { key: 'F', title: 'Partnership', body: 'A shared commitment to success with clients, consultants, and stakeholders.' },
];

const why = [
  { note: 'End-to-end', body: 'End-to-end capability across development, construction, engineering, and real-estate advisory.' },
  { note: 'Quality',    body: 'Uncompromising focus on long-term value — assets built to endure, not to flip.' },
  { note: 'Process',    body: 'Transparent process, documented progress, and trusted delivery — the antidote to abandoned-project risk.' },
  { note: 'Legacy',     body: 'A brand defined by distinction, craftsmanship, and generational stewardship.' },
];
---
<BaseLayout
  title="About — Signature Crest Builders"
  description="Signature Crest Builders Limited is a Ghanaian real-estate development, construction, and engineering practice defined by integrity, excellence, and legacy."
>
  <HeroBlueprint
    kind="floor-plan"
    runningHead={{ code: 'SCBL', section: 'The Practice' }}
    title="A practice built on craftsmanship, trust, and legacy."
    lede="Signature Crest Builders Limited is a distinguished Ghanaian real-estate development, construction, and engineering company — dedicated to creating exceptional spaces that stand the test of time."
    detailImage="/hero/about.webp"
    detailImageAlt="A working scene from the Signature Crest practice."
    detailCaption="Interior detail · a working residence"
    aside="Apolonia, Greater Accra — Ghana."
  />

  <!-- Background -->
  <section class="relative sc-section-tight">
    <div class="sc-container sc-gutter grid grid-cols-12 gap-8 md:gap-12">
      <div class="col-span-12 md:col-span-4">
        <p class="sc-bracket-label">Our Background</p>
        <h2 class="sc-heading-lg sc-text-primary mt-4 max-w-[18ch]">A clear purpose from the beginning.</h2>
      </div>
      <div class="col-span-12 md:col-span-8 space-y-6 sc-lede sc-text-secondary max-w-[62ch]">
        <p>Founded on the principles of excellence and reliability, Signature Crest Builders Limited has grown into a trusted name in premium property development and construction in Ghana.</p>
        <p>Our journey began with a clear purpose: to raise the standard of building and development by uniting design ambition with engineering rigour and disciplined project delivery. Today, we operate across residential, commercial, and mixed-use sectors — offering clients a seamless end-to-end experience from land acquisition and master planning through construction, engineering, and real-estate solutions.</p>
        <p class="sc-text-primary">At the heart of our work is a belief that great buildings are more than structures; they are enduring assets that shape communities and preserve value for generations.</p>
      </div>
    </div>
  </section>

  <!-- Photo band — the practice at work, grounding "Apolonia, Greater Accra" in something real -->
  <section class="relative sc-section-tight">
    <div class="sc-container sc-gutter">
      <div class="relative overflow-hidden aspect-[16/7] md:aspect-[16/6]">
        <img
          src="/hero/realtor-chatting.webp"
          alt="A Signature Crest realtor in conversation with a client."
          class="h-full w-full object-cover"
          loading="lazy"
          decoding="async"
        />
        <div class="absolute inset-0 sc-overlay-image-bottom-to-top"></div>
      </div>
    </div>
  </section>

  <!-- Mission / Vision on ivory -->
  <section class="relative sc-section sc-bg-ivory sc-text-primary-light">
    <div class="sc-container sc-gutter grid grid-cols-12 gap-12">
      <div class="col-span-12 md:col-span-6">
        <p class="sc-bracket-label sc-text-accent-subdued">Mission</p>
        <p class="sc-heading-lg mt-6">
          To hold every stage of a Ghanaian asset — land diligence, design, engineering, construction, and real-estate advisory — under one commercial position and one senior partner, so principals building at home or directing from abroad are never left managing the gaps between contractors who don't answer to each other.
        </p>
      </div>
      <div class="col-span-12 md:col-span-6">
        <p class="sc-bracket-label sc-text-accent-subdued">Vision</p>
        <p class="sc-heading-lg mt-6">
          To be the name Ghanaian and diaspora principals default to when the outcome has to be right — not the fastest quote, not the cheapest one, but the practice still standing behind the asset in its fiftieth year.
        </p>
      </div>
    </div>
  </section>

  <!-- Values — lettered index (A–F), not "01/02/03" numbered -->
  <section id="values" class="relative sc-section">
    <MeshGlow position="top-left" size="lg" intensity={0.05} />
    <div class="sc-container sc-gutter">
      <div class="grid grid-cols-12 gap-8 mb-14">
        <div class="col-span-12 md:col-span-4">
          <p class="sc-bracket-label">Core Values</p>
          <h2 class="sc-display-lg sc-text-primary mt-4 max-w-[20ch]">Six commitments we do not negotiate.</h2>
        </div>
      </div>
      <div class="border-t sc-border-hairline">
        {values.map((v) => (
          <div class="border-b sc-border-hairline grid grid-cols-12 gap-6 py-8 md:py-10">
            <div class="col-span-2 md:col-span-1">
              <span class="sc-slug sc-text-accent-subdued">{v.key}</span>
            </div>
            <div class="col-span-10 md:col-span-4">
              <h3 class="sc-heading-md sc-text-primary">{v.title}</h3>
            </div>
            <div class="col-span-12 md:col-span-7">
              <p class="sc-body sc-text-muted-strong max-w-[52ch]">{v.body}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Approach -->
  <section id="approach" class="relative sc-section-tight">
    <div class="sc-container sc-gutter grid grid-cols-12 gap-8 md:gap-12">
      <div class="col-span-12 md:col-span-5">
        <p class="sc-bracket-label">Our Approach</p>
        <h2 class="sc-heading-lg sc-text-primary mt-4">Disciplined process. Uncommon outcomes.</h2>
      </div>
      <div class="col-span-12 md:col-span-7 space-y-6 sc-lede sc-text-secondary max-w-[62ch]">
        <p>Outstanding results come from a disciplined yet creative process.</p>
        <p>We begin with deep listening and thorough planning, followed by precise engineering and meticulous construction. Our integrated model — combining real-estate insight, design-and-build capability, and rigorous project management — ensures clarity, control, and quality at every stage.</p>
        <p class="sc-text-primary">The result is more than a completed building. It is a Signature Crest property — thoughtfully conceived, expertly executed, and built to last.</p>
      </div>
    </div>
  </section>

  <!-- Why Signature Crest -->
  <section class="relative sc-section sc-bg-ivory sc-text-primary-light">
    <div class="sc-container sc-gutter">
      <p class="sc-bracket-label sc-text-accent-subdued">Why Signature Crest</p>
      <h2 class="sc-display-lg mt-4 max-w-[22ch]">The reasons principals stay.</h2>
      <ul class="mt-14 grid grid-cols-1 md:grid-cols-2 gap-x-12 gap-y-8">
        {why.map((w) => (
          <li class="border-t sc-border-firm-light pt-6">
            <p class="sc-slug sc-text-accent-subdued">{w.note}</p>
            <p class="sc-lede mt-3">{w.body}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- CTA -->
  <section class="relative sc-section-tight">
    <div class="sc-container sc-gutter">
      <RunningHead code="SCBL" section="Begin a project" />
      <div class="mt-14 grid grid-cols-12 gap-8">
        <div class="col-span-12 md:col-span-8">
          <h2 class="sc-display-lg sc-text-primary max-w-[24ch]">
            Begin a project with the practice.
          </h2>
        </div>
        <div class="col-span-12 md:col-span-4 md:pt-8">
          <a href="/contact#form" class="sc-btn-primary">Begin a project</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
