---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import RunningHead from '../components/RunningHead.astro';
import PillarBento from '../components/PillarBento.astro';
import ProjectCard from '../components/ProjectCard.astro';
import InsightCard from '../components/InsightCard.astro';
import MeshGlow from '../components/MeshGlow.astro';
import Reveal from '../components/Reveal.astro';
import { pillars } from '../lib/pillars.ts';

const portfolio = await getCollection('portfolio');
portfolio.sort((a, b) => b.data.year - a.data.year);
const featured = portfolio.slice(0, 3);

const insights = await getCollection('insights');
insights.sort((a, b) => b.data.published.getTime() - a.data.published.getTime());
const notes = insights.slice(0, 2);

const services = await getCollection('services');
const bentoPillars = pillars.map((p) => {
  const record = services.find((s) => s.id === p.slug || s.id.startsWith(p.slug));
  return {
    slug: p.slug,
    title: p.title,
    href: p.href,
    icon: p.icon,
    short: p.short,
    subServices: (record?.data.sub_services ?? []).slice(0, 3),
  };
});
---
<BaseLayout
  title="Signature Crest Builders — A single accountable practice"
  description="Signature Crest Builders Limited: Ghana's integrated real-estate development, construction, and engineering practice. Six pillars, one accountable roof, built for legacy — for principals in Accra and abroad."
>
  <Hero
    runningHead={{ code: 'SCBL', rev: 'REV 01', section: 'Practice' }}
    title="A single practice for the whole building lifecycle."
    lede="Signature Crest Builders is a Ghanaian real-estate development, construction, and engineering practice. Six pillars, one accountable partner — for principals building in Accra and directing from abroad."
    aside="Founded on integrity, excellence, and legacy. Airport Residential, Accra."
    image="https://images.unsplash.com/photo-1600585154340-be6161a56a0c?w=2400&q=80"
    imageAlt="A warm-lit modern residence at dusk with clean rectilinear volumes and a lit portico."
    primaryCta={{ label: 'Begin a project', href: '/contact#form' }}
    secondaryCta={{ label: 'See the practice', href: '/services' }}
  />

  <!-- Position statement -->
  <section class="relative sc-section-tight">
    <div class="sc-container sc-gutter grid grid-cols-12 gap-8">
      <div class="col-span-12 md:col-span-4">
        <p class="sc-bracket-label">The Position</p>
      </div>
      <div class="col-span-12 md:col-span-8">
        <p class="sc-heading-lg sc-text-primary max-w-[24ch]">
          The Ghanaian premium build market forces principals to coordinate developer, contractor, engineer, and agency across their own time zone. We do that work under one roof — so nothing is lost at the seams.
        </p>
        <p class="sc-body sc-text-muted mt-8 max-w-[62ch]">
          Land title, design, engineering, construction, real-estate advisory, and post-handover stewardship are held by one team, on one commercial position, answerable to one senior partner. The result is fewer interface failures, clearer accountability, and an asset whose long-term value is protected by the same practice that built it.
        </p>
      </div>
    </div>
  </section>

  <!-- Six pillars bento -->
  <section class="relative sc-section sc-bg-ivory sc-text-primary-light">
    <div class="sc-container sc-gutter">
      <div class="grid grid-cols-12 gap-8 mb-12 md:mb-16">
        <div class="col-span-12 md:col-span-4">
          <p class="sc-bracket-label sc-text-accent-subdued">Suite of Services</p>
        </div>
        <div class="col-span-12 md:col-span-8">
          <h2 class="sc-display-lg">Six pillars. One signature.</h2>
          <p class="sc-lede sc-text-muted mt-6 max-w-[62ch]">
            Development, construction, engineering, real-estate advisory, project management, and specialist practices — held under one accountable roof. No hand-offs, no split incentives, no separately-priced surprises.
          </p>
        </div>
      </div>
      <PillarBento pillars={bentoPillars} tone="ivory" />
    </div>
  </section>

  <!-- Selected work -->
  <section class="relative sc-section">
    <MeshGlow position="bottom-right" size="lg" intensity={0.06} />
    <div class="sc-container sc-gutter">
      <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-6 mb-12 md:mb-16">
        <div>
          <p class="sc-bracket-label">Selected Work</p>
          <h2 class="sc-display-lg sc-text-primary mt-4 max-w-[22ch]">Assets built to compound, not to flip.</h2>
        </div>
        <a href="/portfolio" class="sc-link sc-small sc-text-accent shrink-0">See the full record</a>
      </div>

      <div class="flex flex-col gap-14 md:gap-16">
        {featured.map((project, i) => (
          <ProjectCard
            index={i + 1}
            title={project.data.title}
            slug={project.data.slug}
            location={project.data.location}
            year={project.data.year}
            pillars={project.data.pillars}
            image={project.data.hero_image}
            variant="index"
            aspect={i === 1 ? 'portrait' : 'landscape'}
          />
        ))}
      </div>
    </div>
  </section>

  <!-- Insights -->
  <section class="relative sc-section-tight">
    <div class="sc-container sc-gutter">
      <div class="grid grid-cols-12 gap-8 mb-8 md:mb-12">
        <div class="col-span-12 md:col-span-4">
          <p class="sc-bracket-label">Field Notes</p>
        </div>
        <div class="col-span-12 md:col-span-8">
          <h2 class="sc-display-lg sc-text-primary max-w-[24ch]">The work behind the work.</h2>
        </div>
      </div>
      <div>
        {notes.map((post) => (
          <InsightCard
            title={post.data.title}
            slug={post.data.slug}
            pillar={post.data.pillar}
            published={post.data.published}
            reading_time={post.data.reading_time}
            excerpt={post.data.excerpt}
            variant="row"
          />
        ))}
      </div>
    </div>
  </section>

  <!-- Anchor — quiet closing invitation -->
  <section class="relative sc-section">
    <div class="sc-container sc-gutter">
      <RunningHead code="SCBL" rev="ANCHOR" section="A conversation" />
      <div class="grid grid-cols-12 gap-8 mt-16 md:mt-20">
        <div class="col-span-12 md:col-span-8">
          <h2 class="sc-display-lg sc-text-primary max-w-[26ch]">
            A conversation is where every Signature Crest asset begins.
          </h2>
        </div>
        <div class="col-span-12 md:col-span-4 md:pt-8">
          <p class="sc-body sc-text-muted">
            Whether you are on-site in Accra or writing from London, Toronto, or New York — the same partner receives the enquiry and stays with the project through to the fiftieth year of the asset.
          </p>
          <a href="/contact#form" class="sc-btn-primary mt-8">Speak with the practice</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
