---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import RunningHead from '../components/RunningHead.astro';
import MarqueeStrip from '../components/MarqueeStrip.astro';
import PillarStickyDirectory from '../components/PillarStickyDirectory.astro';
import PropertyCard from '../components/PropertyCard.astro';
import { Image } from 'astro:assets';

const insights = await getCollection('insights');
insights.sort((a, b) => b.data.published.getTime() - a.data.published.getTime());
const notes = insights.slice(0, 3);

const allProperties = (await getCollection('properties')).sort((a, b) => a.data.order - b.data.order);
const featuredProperties = allProperties.slice(0, 3);
const otherLocations = allProperties.slice(3);

const services = await getCollection('services');
function recordFor(slug: string) {
  return services.find((s) => s.id === slug || s.id.startsWith(slug + '.'));
}
function heroImageFor(slug: string): string {
  return recordFor(slug)?.data.hero_image ?? '';
}

// Homepage-only pillar hooks — punchier than the /services `short` copy.
// Each pairs the concrete mechanism with the reader's actual payoff, one line.
const pillarTeasers = [
  {
    n: '01', title: 'Property Development', href: '/services/development',
    icon: 'lucide:landmark',
    hook: "One team from land search to handover, so nothing stalls waiting on someone else's decision.",
    image: heroImageFor('development'),
    imageAlt: 'A warm-lit modern residence at dusk with clean rectilinear volumes and a lit portico.',
  },
  {
    n: '02', title: 'Construction', href: '/services/construction',
    icon: 'ph:hard-hat-thin',
    hook: 'The finish you were promised, because we self-perform the trades that decide it.',
    image: heroImageFor('construction'),
    imageAlt: 'A construction site at golden hour with a partially poured concrete frame against the sky.',
  },
  {
    n: '03', title: 'Engineering', href: '/services/engineering',
    icon: 'ph:blueprint-thin',
    hook: 'No shortcuts, no remedial work later: our engineers own every load path.',
    image: heroImageFor('engineering'),
    imageAlt: 'A modern white residence with cantilevered volumes in a manicured landscape.',
  },
  {
    n: '04', title: 'Real Estate', href: '/services/real-estate',
    icon: 'lucide:building-2',
    hook: "Advice you can trust, because we've actually built what we're advising on.",
    image: heroImageFor('real-estate'),
    imageAlt: 'An interior room framed by tall glazing looking out onto a garden.',
  },
  {
    n: '05', title: 'Project Management', href: '/services/management',
    icon: 'lucide:clipboard-check',
    hook: "Your budget and timeline, protected by a team that isn't also the one spending it.",
    image: heroImageFor('management'),
    imageAlt: 'A carefully appointed interior with warm timber, brass detailing, and considered lighting.',
  },
  {
    n: '06', title: 'Specialist', href: '/services/specialist',
    icon: 'ph:diamonds-four-thin',
    hook: 'The craftsmanship difference clients notice years after handover.',
    image: heroImageFor('specialist'),
    imageAlt: 'A close-in interior study of textured plaster and dark timber, in the language of a heritage restoration.',
  },
];

const monthNames = ['JAN','FEB','MAR','APR','MAY','JUN','JUL','AUG','SEP','OCT','NOV','DEC'];
function datestamp(d: Date) {
  return { m: monthNames[d.getMonth()], d: String(d.getDate()).padStart(2, '0'), y: String(d.getFullYear()) };
}
---
<BaseLayout
  title="Signature Crest Builders — Construction & Real Estate, Accra, Ghana"
  description="Ghana's integrated real-estate development, construction, and engineering practice — six pillars, one accountable roof, for principals in Accra and abroad."
>
  <Hero
    runningHead={{ code: 'SCBL', section: 'Practice' }}
    title="A single practice for the whole building lifecycle."
    lede="Signature Crest Builders combines real estate development, engineering, and construction under one roof. Six core disciplines, one accountable team, total transparency for clients in Accra and abroad."
    aside="Founded on integrity, excellence, and legacy. Apolonia, Greater Accra."
    kenBurnsImages={[
      '/images/airview.webp',
      '/images/construction.webp',
      '/images/rs.webp'
    ]}
    primaryCta={{ label: 'Begin a project', href: '/contact#form' }}
    secondaryCta={{ label: 'See the practice', href: '/services' }}
  />

  <!-- Brand anthem: crossed ribbons directly under the hero -->
  <MarqueeStrip top="BUILT ON TRUST" bottom="DESIGNED FOR LEGACY" />

  <!-- Mini-about: hook · position · payoff -->
  <section class="relative sc-section-tight">
    <div class="sc-container sc-gutter grid grid-cols-12 gap-8">
      <div class="col-span-12 md:col-span-4">
        <p class="sc-bracket-label">The Practice</p>
        <p class="sc-caption sc-text-muted mt-4 max-w-[28ch] leading-relaxed">
          Founded on integrity, excellence, and legacy. Apolonia, Greater Accra.
        </p>
      </div>
      <div class="col-span-12 md:col-span-8">
        <h2 class="sc-heading-lg sc-text-primary max-w-[26ch]">
          Building in Ghana often means coordinating several separate teams from overseas without anyone taking true ownership of the final result.
        </h2>
        <p class="sc-body sc-text-muted-strong mt-8 max-w-[62ch]">
          Signature Crest Builders manages every stage of your project under one practice. Land diligence, architectural design, engineering, construction, real estate advisory, and post-handover care are all handled by a single team with one clear budget and direct partner accountability.
        </p>
        <p class="sc-body sc-text-muted mt-5 max-w-[62ch]">
          For clients in Accra and families managing builds from overseas, you get direct line access to the senior partner tracking your project. No call centers, no middle managers, and no communication gaps.
        </p>
      </div>
    </div>
  </section>

  <!-- The Suite — sticky-image directory of the six pillars -->
  <PillarStickyDirectory pillars={pillarTeasers} />

  <!-- Available Properties — real current inventory, featured -->
  <section class="relative sc-section-tight">
    <div class="sc-container sc-gutter">
      <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-6 mb-12 md:mb-16">
        <div>
          <p class="sc-bracket-label">Currently Available</p>
          <h2 class="sc-display-lg sc-text-primary mt-4 max-w-[22ch]">Land ready to build on, today.</h2>
        </div>
        <a href="/available-properties" class="sc-link sc-small sc-text-accent shrink-0">View all available properties</a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 md:gap-8">
        {featuredProperties.map((p) => (
          <PropertyCard
            title={p.data.title}
            slug={p.data.slug}
            location={p.data.location}
            price={p.data.price}
            status={p.data.status}
            summary={p.data.summary}
            hero_image={p.data.hero_image}
            specs={p.data.specs}
            showPrice={false}
          />
        ))}
      </div>

      {otherLocations.length > 0 && (
        <div class="mt-10 md:mt-12">
          <p class="sc-caption sc-text-muted mb-4 uppercase" style="letter-spacing: 0.1em;">Also available in</p>
          <div class="flex flex-wrap gap-3">
            {otherLocations.map((p) => (
              <a
                href="/available-properties"
                class="group inline-flex items-center gap-2.5 pl-1.5 pr-4 py-1.5 rounded-full border sc-border-hairline hover:border-[color:var(--sc-border-accent)] transition-colors"
              >
                <span class="relative block w-8 h-8 rounded-full overflow-hidden shrink-0">
                  <Image
                    src={p.data.hero_image}
                    alt={p.data.location}
                    width={64}
                    height={64}
                    class="h-full w-full object-cover"
                    loading="lazy"
                    format="webp"
                  />
                </span>
                <span class="sc-small sc-text-primary group-hover:text-[color:var(--sc-text-accent-hover)] transition-colors">
                  {p.data.location.split(',')[0]}
                </span>
              </a>
            ))}
          </div>
        </div>
      )}
    </div>
  </section>

  <!-- Insights — Blog posts + featured content -->
  <section class="relative sc-section-tight">
    <div class="sc-container sc-gutter">
      <div class="grid grid-cols-12 gap-8 mb-12 md:mb-16">
        <div class="col-span-12 md:col-span-4">
          <p class="sc-bracket-label">Insights</p>
        </div>
        <div class="col-span-12 md:col-span-8">
          <h2 class="sc-display-lg sc-text-primary max-w-[24ch]">Thinking behind our builds.</h2>
        </div>
      </div>

      <div class="grid grid-cols-12 gap-10 md:gap-16">
        <!-- Blog posts column — dated index -->
        <div class="col-span-12 md:col-span-7">
          <h3 class="sc-bracket-label mb-6">Recent Posts</h3>
          <ul class="border-t sc-border-hairline">
            {notes.map((post) => {
              const ds = datestamp(post.data.published);
              return (
                <li class="border-b sc-border-hairline py-6 md:py-7">
                  <a
                    href={`/insights/${post.data.slug}`}
                    class="group grid grid-cols-12 gap-4 md:gap-6 items-baseline"
                  >
                    <div class="col-span-3 md:col-span-2 text-center">
                      <p class="sc-slug sc-text-accent-subdued">{ds.m}</p>
                      <p class="font-display sc-text-accent mt-1" style="font-size: 2rem; line-height: 1; font-variation-settings: 'opsz' 48;">{ds.d}</p>
                      <p class="sc-slug sc-text-accent-subdued mt-1">{ds.y}</p>
                    </div>
                    <div class="col-span-9 md:col-span-10">
                      <h4 class="sc-heading-md sc-text-primary transition-colors duration-500 group-hover:text-[color:var(--sc-text-accent-hover)]">
                        {post.data.title}
                      </h4>
                      <p class="sc-small sc-text-muted mt-3 max-w-[60ch]">{post.data.excerpt}</p>
                      <span class="sc-link sc-small sc-text-accent inline-block mt-3">Read the note</span>
                    </div>
                  </a>
                </li>
              );
            })}
          </ul>

          <a
            href="/insights"
            class="inline-flex items-center gap-3 mt-10 px-6 py-3 border sc-border-accent-firm rounded-full sc-text-accent hover:bg-[color:var(--sc-text-accent)] hover:text-[color:var(--sc-surface-canvas)] transition-colors sc-caption uppercase"
          >
            All Blog Posts
          </a>
        </div>

        <!-- Voices column — placeholder client testimonial slot -->
        <div class="col-span-12 md:col-span-5 md:pl-8 md:border-l sc-border-hairline">
          <h3 class="sc-bracket-label mb-6">Voices</h3>

          <svg viewBox="0 0 32 24" width="36" height="27" aria-hidden="true" class="sc-text-accent-subdued opacity-60 mb-6">
            <path fill="currentColor" d="M0 24V13.6C0 6.1 4.1 1.4 12.2 0v4.8C7.8 6.4 5.6 9.7 5.6 13.6H12V24H0zm20 0V13.6C20 6.1 24.1 1.4 32.2 0v4.8C27.8 6.4 25.6 9.7 25.6 13.6H32V24H20z"/>
          </svg>

          <blockquote class="font-display sc-text-primary" style="font-size: clamp(1.25rem, 2vw, 1.65rem); line-height: 1.35; font-variation-settings: 'opsz' 48; font-style: italic; font-weight: 500;">
            Buying land in Ghana from abroad felt like a huge gamble until I found them. Their legal team removed all the fear, securing my fully registered plot in Oyarifa in just a few weeks. Zero land guards, complete transparency, total peace of mind.
          </blockquote>

          <div class="mt-8 flex items-center gap-4">
            <span class="block h-px w-10 bg-[color:var(--sc-text-accent)]"></span>
            <p class="sc-slug sc-text-accent">
              Kwame Mensah · UK-Based Healthcare Professional
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Anchor — full-bleed image-backed closing invitation -->
  <section class="relative isolate min-h-[80vh] overflow-hidden">
    <div class="absolute inset-0 -z-10 sc-final-cta-bg" aria-hidden="true"></div>
    <div class="absolute inset-0 -z-10 sc-final-cta-scrim" aria-hidden="true"></div>

    <div class="sc-container sc-gutter pt-24 md:pt-32">
      <RunningHead code="SCBL" section="A conversation" />
    </div>

    <div class="sc-container sc-gutter pt-16 md:pt-20 pb-24 md:pb-32">
      <div class="grid grid-cols-12 gap-8">
        <div class="col-span-12 md:col-span-8">
          <h2 class="sc-display-xl sc-text-primary max-w-[22ch]">
            A conversation is where every Signature Crest asset begins.
          </h2>
        </div>
        <div class="col-span-12 md:col-span-4 md:pt-10">
          <p class="sc-lede sc-text-secondary">
            Whether you are based in Accra or managing your build from abroad, you work with the same accountable team from your first call to long after project completion.
          </p>
          <a href="/contact#form" class="sc-btn-primary mt-8">Begin a project</a>
        </div>
      </div>
    </div>

    <style>
      .sc-final-cta-bg {
        background-image: url('/final-cta.avif');
        background-size: cover;
        background-position: center;
        background-repeat: no-repeat;
      }
      .sc-final-cta-scrim {
        background: linear-gradient(
          to bottom,
          color-mix(in oklab, var(--color-sc-navy) 55%, transparent) 0%,
          color-mix(in oklab, var(--color-sc-navy) 70%, transparent) 45%,
          color-mix(in oklab, var(--color-sc-navy) 88%, transparent) 100%
        );
      }
    </style>
  </section>
</BaseLayout>
