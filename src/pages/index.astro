---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import RunningHead from '../components/RunningHead.astro';
import ProjectCard from '../components/ProjectCard.astro';
import MarqueeStrip from '../components/MarqueeStrip.astro';
import MeshGlow from '../components/MeshGlow.astro';
import PillarStickyDirectory from '../components/PillarStickyDirectory.astro';

const portfolio = await getCollection('portfolio');
portfolio.sort((a, b) => b.data.year - a.data.year);
const featured = portfolio.slice(0, 3);

const insights = await getCollection('insights');
insights.sort((a, b) => b.data.published.getTime() - a.data.published.getTime());
const notes = insights.slice(0, 3);

const services = await getCollection('services');
function subServicesFor(slug: string): string[] {
  const record = services.find((s) => s.id === slug || s.id.startsWith(slug + '.'));
  return (record?.data.sub_services ?? []).slice(0, 4);
}

// Homepage-only pillar hooks — punchier than the /services `short` copy.
// One line, verb-forward, written for the diaspora + local HNW reader.
const pillarTeasers = [
  {
    n: '01', title: 'Property Development', href: '/services/development',
    icon: 'lucide:landmark',
    hook: 'Land search through handover on one commercial line.',
    subServices: subServicesFor('development'),
    image: 'https://images.unsplash.com/photo-1600585154340-be6161a56a0c?w=1400&q=80',
    imageAlt: 'A warm-lit modern residence at dusk with clean rectilinear volumes and a lit portico.',
  },
  {
    n: '02', title: 'Construction', href: '/services/construction',
    icon: 'ph:crane-thin',
    hook: 'Self-perform the trades that decide the finish.',
    subServices: subServicesFor('construction'),
    image: 'https://images.unsplash.com/photo-1449844908441-8829872d2607?w=1400&q=80',
    imageAlt: 'A construction site at golden hour with a partially poured concrete frame against the sky.',
  },
  {
    n: '03', title: 'Engineering', href: '/services/engineering',
    icon: 'ph:blueprint-thin',
    hook: 'In-house structural, civil, MEP, and geotechnical teams that stand behind every load path.',
    subServices: subServicesFor('engineering'),
    image: 'https://images.unsplash.com/photo-1512917774080-9991f1c4c750?w=1400&q=80',
    imageAlt: 'A modern white residence with cantilevered volumes in a manicured landscape.',
  },
  {
    n: '04', title: 'Real Estate', href: '/services/real-estate',
    icon: 'lucide:building-2',
    hook: 'Advisory paired with build capability — the underwrite made real.',
    subServices: subServicesFor('real-estate'),
    image: 'https://images.unsplash.com/photo-1600566753190-17f0baa2a6c3?w=1400&q=80',
    imageAlt: 'An interior room framed by tall glazing looking out onto a garden.',
  },
  {
    n: '05', title: 'Project Management', href: '/services/management',
    icon: 'lucide:clipboard-check',
    hook: 'Programme, cost, quality, safety — one accountable governor.',
    subServices: subServicesFor('management'),
    image: 'https://images.unsplash.com/photo-1600607687939-ce8a6c25118c?w=1400&q=80',
    imageAlt: 'A carefully appointed interior with warm timber, brass detailing, and considered lighting.',
  },
  {
    n: '06', title: 'Specialist', href: '/services/specialist',
    icon: 'ph:diamonds-four-thin',
    hook: 'Sustainable, bespoke, heritage, and after-sales stewardship.',
    subServices: subServicesFor('specialist'),
    image: 'https://picsum.photos/seed/scbl-specialist/1200/1500',
    imageAlt: 'A close-in interior study of textured plaster and dark timber, in the language of a heritage restoration.',
  },
];

const monthNames = ['JAN','FEB','MAR','APR','MAY','JUN','JUL','AUG','SEP','OCT','NOV','DEC'];
function datestamp(d: Date) {
  return { m: monthNames[d.getMonth()], d: String(d.getDate()).padStart(2, '0'), y: String(d.getFullYear()) };
}
---
<BaseLayout
  title="Signature Crest Builders — A single accountable practice"
  description="Signature Crest Builders Limited: Ghana's integrated real-estate development, construction, and engineering practice. Six pillars, one accountable roof, built for legacy — for principals in Accra and abroad."
>
  <Hero
    runningHead={{ code: 'SCBL', rev: 'REV 01', section: 'Practice' }}
    title="A single practice for the whole building lifecycle."
    lede="Signature Crest Builders is a Ghanaian real-estate development, construction, and engineering practice. Six pillars, one accountable partner — for principals building in Accra and directing from abroad."
    aside="Founded on integrity, excellence, and legacy. Airport Residential, Accra."
    image="https://images.unsplash.com/photo-1600585154340-be6161a56a0c?w=2400&q=80"
    imageAlt="A warm-lit modern residence at dusk with clean rectilinear volumes and a lit portico."
    primaryCta={{ label: 'Begin a project', href: '/contact#form' }}
    secondaryCta={{ label: 'See the practice', href: '/services' }}
  />

  <!-- Brand anthem: crossed ribbons directly under the hero -->
  <MarqueeStrip top="BUILT ON TRUST" bottom="DESIGNED FOR LEGACY" />

  <!-- Mini-about: hook · position · payoff -->
  <section class="relative sc-section-tight">
    <div class="sc-container sc-gutter grid grid-cols-12 gap-8">
      <div class="col-span-12 md:col-span-4">
        <p class="sc-bracket-label">The Practice</p>
        <p class="sc-caption sc-text-muted mt-4 max-w-[28ch] leading-relaxed">
          Founded on integrity, excellence, and legacy. Airport Residential, Accra.
        </p>
      </div>
      <div class="col-span-12 md:col-span-8">
        <p class="sc-heading-lg sc-text-primary max-w-[26ch]">
          Building in Ghana usually means coordinating four vendors across an ocean — and no one holding the outcome.
        </p>
        <p class="sc-body sc-text-muted-strong mt-8 max-w-[62ch]">
          Signature Crest Builders is one practice for the whole of it. Land diligence, design, engineering, construction, real-estate advisory, and post-handover care — held by the same team, priced on one commercial position, answerable to one senior partner.
        </p>
        <p class="sc-body sc-text-muted mt-5 max-w-[62ch]">
          In Accra, and for families writing from London, Toronto, and New York, that partner is who receives the enquiry, stands at handover, and is still on the phone in the fiftieth year of the asset.
        </p>
      </div>
    </div>
  </section>

  <!-- The Suite — sticky-image directory of the six pillars -->
  <PillarStickyDirectory pillars={pillarTeasers} />

  <!-- Selected work -->
  <section class="relative sc-section">
    <MeshGlow position="bottom-right" size="lg" intensity={0.06} />
    <div class="sc-container sc-gutter">
      <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-6 mb-12 md:mb-16">
        <div>
          <p class="sc-bracket-label">Selected Work</p>
          <h2 class="sc-display-lg sc-text-primary mt-4 max-w-[22ch]">Assets built to compound, not to flip.</h2>
        </div>
        <a href="/portfolio" class="sc-link sc-small sc-text-accent shrink-0">See the full record</a>
      </div>

      <div class="flex flex-col gap-14 md:gap-16">
        {featured.map((project, i) => (
          <ProjectCard
            index={i + 1}
            title={project.data.title}
            slug={project.data.slug}
            location={project.data.location}
            year={project.data.year}
            pillars={project.data.pillars}
            image={project.data.hero_image}
            variant="index"
            aspect={i === 1 ? 'portrait' : 'landscape'}
          />
        ))}
      </div>
    </div>
  </section>

  <!-- The work behind the work — Field Notes (dated index) + Voices (pull-quote) -->
  <section class="relative sc-section-tight">
    <div class="sc-container sc-gutter">
      <div class="grid grid-cols-12 gap-8 mb-12 md:mb-16">
        <div class="col-span-12 md:col-span-4">
          <p class="sc-bracket-label">Field Notes</p>
        </div>
        <div class="col-span-12 md:col-span-8">
          <h2 class="sc-display-lg sc-text-primary max-w-[24ch]">The work behind the work.</h2>
        </div>
      </div>

      <div class="grid grid-cols-12 gap-10 md:gap-16">
        <!-- Field Notes column — dated index -->
        <div class="col-span-12 md:col-span-7">
          <h3 class="sc-bracket-label mb-6">Notes</h3>
          <ul class="border-t sc-border-hairline">
            {notes.map((post) => {
              const ds = datestamp(post.data.published);
              return (
                <li class="border-b sc-border-hairline py-6 md:py-7">
                  <a
                    href={`/insights/${post.data.slug}`}
                    class="group grid grid-cols-12 gap-4 md:gap-6 items-baseline"
                  >
                    <div class="col-span-3 md:col-span-2 text-center">
                      <p class="sc-slug sc-text-accent-subdued">{ds.m}</p>
                      <p class="font-display sc-text-accent mt-1" style="font-size: 2rem; line-height: 1; font-variation-settings: 'opsz' 48;">{ds.d}</p>
                      <p class="sc-slug sc-text-accent-subdued mt-1">{ds.y}</p>
                    </div>
                    <div class="col-span-9 md:col-span-10">
                      <h4 class="sc-heading-md sc-text-primary transition-colors duration-500 group-hover:text-[color:var(--sc-text-accent-hover)]">
                        {post.data.title}
                      </h4>
                      <p class="sc-small sc-text-muted mt-3 max-w-[60ch]">{post.data.excerpt}</p>
                      <span class="sc-link sc-small sc-text-accent inline-block mt-3">Read the note</span>
                    </div>
                  </a>
                </li>
              );
            })}
          </ul>

          <a
            href="/insights"
            class="inline-flex items-center gap-3 mt-10 px-6 py-3 border sc-border-accent-firm rounded-full sc-text-accent hover:bg-[color:var(--sc-text-accent)] hover:text-[color:var(--sc-surface-canvas)] transition-colors sc-caption uppercase"
          >
            All Field Notes
          </a>
        </div>

        <!-- Voices column — placeholder client testimonial slot -->
        <div class="col-span-12 md:col-span-5 md:pl-8 md:border-l sc-border-hairline">
          <h3 class="sc-bracket-label mb-6">Voices</h3>

          <svg viewBox="0 0 32 24" width="36" height="27" aria-hidden="true" class="sc-text-accent-subdued opacity-60 mb-6">
            <path fill="currentColor" d="M0 24V13.6C0 6.1 4.1 1.4 12.2 0v4.8C7.8 6.4 5.6 9.7 5.6 13.6H12V24H0zm20 0V13.6C20 6.1 24.1 1.4 32.2 0v4.8C27.8 6.4 25.6 9.7 25.6 13.6H32V24H20z"/>
          </svg>

          <blockquote class="font-display sc-text-primary" style="font-size: clamp(1.25rem, 2vw, 1.65rem); line-height: 1.35; font-variation-settings: 'opsz' 48; font-style: italic; font-weight: 500;">
            Building from abroad shouldn't mean losing sleep over what's happening on site. Documented, on programme, and delivered with the discipline of a practice that thinks in decades, not deals — that is what a Signature Crest engagement looks like.
          </blockquote>

          <div class="mt-8 flex items-center gap-4">
            <span class="block h-px w-10 bg-[color:var(--sc-text-accent)]"></span>
            <p class="sc-slug sc-text-accent">
              The Practice · Diaspora Engagement Note
            </p>
          </div>

          <p class="sc-caption sc-text-muted mt-8 leading-relaxed">
            A client-testimonial slot. Replace with verbatim quotes as they arrive; the layout accommodates one longform or a rotating shortform.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Anchor — full-bleed image-backed closing invitation -->
  <section class="relative isolate min-h-[80vh] overflow-hidden">
    <div class="absolute inset-0 -z-10 sc-final-cta-bg" aria-hidden="true"></div>
    <div class="absolute inset-0 -z-10 sc-final-cta-scrim" aria-hidden="true"></div>

    <div class="sc-container sc-gutter pt-24 md:pt-32">
      <RunningHead code="SCBL" rev="ANCHOR" section="A conversation" />
    </div>

    <div class="sc-container sc-gutter pt-16 md:pt-20 pb-24 md:pb-32">
      <div class="grid grid-cols-12 gap-8">
        <div class="col-span-12 md:col-span-8">
          <h2 class="sc-display-xl sc-text-primary max-w-[22ch]">
            A conversation is where every Signature Crest asset begins.
          </h2>
        </div>
        <div class="col-span-12 md:col-span-4 md:pt-10">
          <p class="sc-lede sc-text-secondary">
            Whether you are on-site in Accra or writing from London, Toronto, or New York — the same partner receives the enquiry and stays with the project through to the fiftieth year of the asset.
          </p>
          <a href="/contact#form" class="sc-btn-primary mt-8">Speak with the practice</a>
        </div>
      </div>
    </div>

    <style>
      .sc-final-cta-bg {
        background-image: url('/final-cta.avif');
        background-size: cover;
        background-position: center;
        background-repeat: no-repeat;
      }
      .sc-final-cta-scrim {
        background: linear-gradient(
          to bottom,
          color-mix(in oklab, var(--color-sc-navy) 55%, transparent) 0%,
          color-mix(in oklab, var(--color-sc-navy) 70%, transparent) 45%,
          color-mix(in oklab, var(--color-sc-navy) 88%, transparent) 100%
        );
      }
    </style>
  </section>
</BaseLayout>
