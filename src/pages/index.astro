---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import PillarBento from '../components/PillarBento.astro';
import ProjectCard from '../components/ProjectCard.astro';
import InsightCard from '../components/InsightCard.astro';
import Reveal from '../components/Reveal.astro';
import MeshGlow from '../components/MeshGlow.astro';
import GridlineFrame from '../components/GridlineFrame.astro';
import { pillars } from '../lib/pillars.ts';

const portfolio = await getCollection('portfolio');
const insights = await getCollection('insights');

const featured = portfolio.slice(0, 3);
const teasers = insights
  .sort((a, b) => b.data.published.getTime() - a.data.published.getTime())
  .slice(0, 2);
---
<BaseLayout
  title="Signature Crest Builders — Distinct by design. Built for legacy."
  description="A single, accountable practice for premium real estate development, construction, and engineering — delivered end-to-end."
>
  <Hero
    eyebrow="Signature Crest Builders Limited"
    title="Distinct by <em class='not-italic sc-text-accent'>design</em>. <br class='hidden md:block'/>Built for <em class='not-italic sc-text-accent'>legacy</em>."
    lede="Architectural vision, engineering precision, and construction excellence — held in one accountable practice, from feasibility through the fiftieth year of the asset."
    image="https://picsum.photos/seed/scbl-hero/2400/1600"
    imageAlt="A cinematic wide-angle view of a Signature Crest development at first light."
    primaryCta={{ label: 'Explore our practice', href: '/services' }}
    secondaryCta={{ label: 'Selected work', href: '/portfolio' }}
  />

  <!-- Statement -->
  <section class="relative isolate px-6 py-32 md:px-10 md:py-48">
    <MeshGlow position="top-left" size="lg" intensity={0.08} />
    <div class="relative mx-auto grid max-w-[1440px] gap-12 md:grid-cols-12" data-reveal-group>
      <div class="md:col-span-4">
        <Reveal>
          <p class="eyebrow">One practice. Six pillars.</p>
        </Reveal>
      </div>
      <div class="md:col-span-8">
        <Reveal>
          <p class="font-display text-3xl leading-[1.15] tracking-tight sc-text-primary md:text-5xl">
            Signature Crest is a distinguished real estate development, construction, and engineering company —
            <span class="sc-text-accent">dedicated to creating exceptional spaces that stand the test of time.</span>
          </p>
        </Reveal>
        <Reveal>
          <p class="mt-8 max-w-2xl text-base leading-relaxed sc-text-muted md:text-lg">
            We combine architectural vision, engineering precision, and construction excellence to deliver projects that embody quality, integrity, and lasting value. Every structure we build carries the Signature Crest mark of distinction — a commitment to craftsmanship, trust, and legacy.
          </p>
        </Reveal>
      </div>
    </div>
  </section>

  <!-- Pillars bento -->
  <section class="relative isolate sc-bg-ivory px-6 py-32 sc-text-primary-light md:px-10 md:py-40">
    <GridlineFrame tone="light" columns={12} />
    <div class="relative mx-auto max-w-[1440px]" data-reveal-group>
      <div class="mb-16 grid gap-8 md:grid-cols-12">
        <div class="md:col-span-4">
          <Reveal>
            <p class="tabular text-xs sc-text-accent-subdued">Suite of Services</p>
          </Reveal>
        </div>
        <div class="md:col-span-8">
          <Reveal>
            <h2 class="font-display text-4xl leading-[1.05] tracking-tight md:text-6xl">
              Six pillars. One <span class="sc-text-accent-subdued">signature</span>.
            </h2>
          </Reveal>
          <Reveal>
            <p class="mt-6 max-w-2xl text-base leading-relaxed sc-text-muted md:text-lg">
              Development, construction, engineering, real estate, project management, and specialist practices — held under one accountable roof. No hand-offs, no split incentives, no separately-priced surprises.
            </p>
          </Reveal>
        </div>
      </div>
      <PillarBento
        pillars={pillars.map((p) => ({ ...p, subServices: [] }))}
        tone="ivory"
      />
    </div>
  </section>

  <!-- Featured projects -->
  <section class="relative isolate px-6 py-32 md:px-10 md:py-48">
    <MeshGlow position="bottom-right" size="lg" intensity={0.10} />
    <div class="mx-auto max-w-[1440px]" data-reveal-group>
      <div class="mb-20 flex items-end justify-between">
        <Reveal>
          <div>
            <p class="eyebrow">Selected Work</p>
            <h2 class="mt-4 font-display text-4xl leading-[1.05] tracking-tight sc-text-primary md:text-6xl">
              Assets that <span class="sc-text-accent">compound</span>.
            </h2>
          </div>
        </Reveal>
        <Reveal>
          <a href="/portfolio" class="hidden md:inline-flex items-center gap-3 text-sm sc-text-accent gold-underline">
            All projects
            <span>→</span>
          </a>
        </Reveal>
      </div>

      <div class="flex flex-col gap-24">
        {featured.map((project, i) => (
          <Reveal>
            <ProjectCard
              title={project.data.title}
              slug={project.data.slug}
              location={project.data.location}
              year={project.data.year}
              pillars={project.data.pillars}
              image={project.data.hero_image}
              aspect={i === 0 ? 'landscape' : i === 1 ? 'portrait' : 'landscape'}
              flip={i % 2 === 1}
            />
          </Reveal>
        ))}
      </div>
    </div>
  </section>

  <!-- Insights teaser -->
  <section class="relative isolate px-6 py-32 md:px-10 md:py-40">
    <div class="mx-auto max-w-[1440px]" data-reveal-group>
      <div class="mb-16 grid gap-8 md:grid-cols-12">
        <div class="md:col-span-4">
          <Reveal>
            <p class="eyebrow">Field Notes</p>
          </Reveal>
        </div>
        <div class="md:col-span-8">
          <Reveal>
            <h2 class="font-display text-4xl leading-[1.05] tracking-tight sc-text-primary md:text-6xl">
              The work behind <span class="sc-text-accent">the work</span>.
            </h2>
          </Reveal>
        </div>
      </div>
      <div class="grid gap-6 md:grid-cols-2">
        {teasers.map((post) => (
          <Reveal>
            <InsightCard
              title={post.data.title}
              slug={post.data.slug}
              pillar={post.data.pillar}
              published={post.data.published}
              reading_time={post.data.reading_time}
              excerpt={post.data.excerpt}
            />
          </Reveal>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="relative isolate px-6 py-32 md:px-10 md:py-48">
    <MeshGlow position="center" size="xl" intensity={0.14} />
    <div class="relative mx-auto max-w-4xl text-center" data-reveal-group>
      <Reveal>
        <p class="eyebrow">Begin a project</p>
      </Reveal>
      <Reveal>
        <h2 class="mt-6 font-display text-5xl leading-[1.02] tracking-tight sc-text-primary md:text-7xl">
          A conversation is where every <span class="sc-text-accent">Signature Crest</span> asset begins.
        </h2>
      </Reveal>
      <Reveal>
        <a href="/contact" class="mt-12 sc-btn-primary px-8 py-4">
          Speak with the practice
          <span>→</span>
        </a>
      </Reveal>
    </div>
  </section>
</BaseLayout>
