---
import { ClientRouter } from 'astro:transitions';
import '@fontsource-variable/fraunces/index.css';
import '@fontsource-variable/inter/index.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import NoiseOverlay from '../components/NoiseOverlay.astro';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  bodyClass?: string;
  canonicalPath?: string;
}

const {
  title = 'Signature Crest Builders — Distinct by design. Built for legacy.',
  description = 'Signature Crest Builders Limited is a Ghanaian real-estate development, construction, and engineering practice — six pillars under one accountable roof, built for legacy.',
  ogImage = '/og.svg',
  bodyClass = '',
  canonicalPath,
} = Astro.props;

const siteOrigin = Astro.site?.toString().replace(/\/$/, '') ?? '';
const path = (canonicalPath ?? Astro.url.pathname.replace(/\/$/, '')) || '/';
const canonical = `${siteOrigin}${path}`;
const absoluteOg = ogImage.startsWith('http') ? ogImage : `${siteOrigin}${ogImage}`;

const orgJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Signature Crest Builders Limited',
  url: siteOrigin,
  logo: `${siteOrigin}/og.svg`,
  description:
    'A distinguished Ghanaian real-estate development, construction, and engineering practice — six pillars under one accountable roof.',
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Apolonia',
    addressLocality: 'Accra',
    addressRegion: 'Greater Accra',
    addressCountry: 'GH',
  },
  contactPoint: {
    '@type': 'ContactPoint',
    contactType: 'sales',
    telephone: '+233500903792',
    email: 'signaturecrestbuilderslimited@gmail.com',
    availableLanguage: ['en'],
  },
  sameAs: [] as string[],
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#050C16" />
    <meta name="color-scheme" content="dark" />
    <title>{title}</title>

    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="en" href={canonical} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Signature Crest Builders" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={absoluteOg} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="en_GH" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={absoluteOg} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href="/_astro/fraunces-latin-wght-normal.woff2"
      crossorigin
    />
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href="/_astro/inter-latin-wght-normal.woff2"
      crossorigin
    />

    <script type="application/ld+json" set:html={JSON.stringify(orgJsonLd)} />

    <ClientRouter />
  </head>
  <body class:list={['sc-bg-canvas sc-text-primary', bodyClass]}>
    <NoiseOverlay />
    <a
      href="#content"
      class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-[200] focus:sc-btn-primary focus:px-4 focus:py-2"
    >
      Skip to content
    </a>
    <Header />
    <main id="content" class="pt-20">
      <slot />
    </main>
    <Footer />

    <script>
      import Lenis from 'lenis';
      import { animate, inView, stagger } from 'motion';

      let lenis: Lenis | null = null;

      function bootLenis() {
        if (typeof window === 'undefined') return;
        const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (reduce) return;
        lenis?.destroy();
        lenis = new Lenis({
          duration: 1.2,
          easing: (t: number) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
          smoothWheel: true,
        });
        function raf(time: number) {
          lenis?.raf(time);
          requestAnimationFrame(raf);
        }
        requestAnimationFrame(raf);
      }

      function bootReveal() {
        const targets = document.querySelectorAll<HTMLElement>('[data-reveal]');
        if (!targets.length) return;
        const groups = new Map<HTMLElement, HTMLElement[]>();
        targets.forEach((el) => {
          const parent = (el.closest<HTMLElement>('[data-reveal-group]') ?? el.parentElement) as HTMLElement;
          const list = groups.get(parent) ?? [];
          list.push(el);
          groups.set(parent, list);
        });
        groups.forEach((els, parent) => {
          inView(parent, () => {
            animate(
              els,
              { opacity: [0, 1], transform: ['translate3d(0, 16px, 0)', 'translate3d(0, 0, 0)'] },
              { duration: 0.7, delay: stagger(0.06), easing: [0.16, 1, 0.3, 1] }
            );
            els.forEach((el) => el.classList.add('is-revealed'));
            return () => {};
          }, { margin: '0px 0px -10% 0px' });
        });
      }

      function init() {
        bootLenis();
        bootReveal();
      }

      init();

      document.addEventListener('astro:after-swap', () => {
        lenis?.destroy();
        lenis = null;
        init();
      });
    </script>

    <style is:global>
      .sr-only {
        position: absolute;
        width: 1px; height: 1px;
        padding: 0; margin: -1px;
        overflow: hidden;
        clip: rect(0,0,0,0);
        white-space: nowrap;
        border: 0;
      }
      .focus\:not-sr-only:focus {
        position: fixed;
        width: auto; height: auto;
        padding: 0; margin: 0;
        overflow: visible;
        clip: auto;
        white-space: normal;
      }
    </style>
  </body>
</html>
