---
import { Image } from 'astro:assets';
import MeshGlow from './MeshGlow.astro';
import Reveal from './Reveal.astro';
import RunningHead from './RunningHead.astro';

interface Props {
  runningHead?: { code?: string; rev?: string; section?: string };
  title: string;               // may contain <br> / raw HTML
  lede?: string;
  aside?: string;              // optional side annotation
  image?: string;
  imageAlt?: string;
  primaryCta?: { label: string; href: string };
  secondaryCta?: { label: string; href: string };
  variant?: 'imaged' | 'quiet';
}

const {
  runningHead,
  title,
  lede,
  aside,
  image,
  imageAlt,
  primaryCta,
  secondaryCta,
  variant = image ? 'imaged' : 'quiet',
} = Astro.props;
---
<section class="relative isolate overflow-hidden">
  <MeshGlow position="top-right" size="xl" intensity={variant === 'imaged' ? 0.10 : 0.06} />

  {variant === 'imaged' && image && (
    <div class="absolute inset-0 -z-10">
      <Image
        src={image}
        alt={imageAlt ?? ''}
        width={2400}
        height={1600}
        widths={[720, 1200, 1800, 2400]}
        sizes="100vw"
        class="h-full w-full object-cover opacity-70"
        loading="eager"
        format="webp"
      />
      <div class="absolute inset-0 sc-overlay-hero-horizontal"></div>
    </div>
  )}

  <div class="sc-container sc-gutter pt-28 md:pt-36">
    {runningHead && (
      <RunningHead
        code={runningHead.code}
        rev={runningHead.rev}
        section={runningHead.section}
      />
    )}
  </div>

  <div
    class="sc-container sc-gutter pb-20 md:pb-32 pt-12 md:pt-20 grid grid-cols-12 gap-6 md:gap-8"
    data-reveal-group
  >
    <div class="col-span-12 md:col-span-10">
      <Reveal>
        <h1 class="sc-display-xl sc-text-primary max-w-[16ch]">
          <Fragment set:html={title} />
        </h1>
      </Reveal>
      {lede && (
        <Reveal>
          <p class="sc-lede-lg sc-text-secondary max-w-[52ch] mt-8 md:mt-10">
            {lede}
          </p>
        </Reveal>
      )}
      {(primaryCta || secondaryCta) && (
        <Reveal>
          <div class="mt-10 md:mt-12 flex flex-wrap items-center gap-4">
            {primaryCta && (
              <a href={primaryCta.href} class="sc-btn-primary">{primaryCta.label}</a>
            )}
            {secondaryCta && (
              <a href={secondaryCta.href} class="sc-btn-secondary">{secondaryCta.label}</a>
            )}
          </div>
        </Reveal>
      )}
      {aside && (
        <Reveal>
          <aside class="sc-body sc-text-accent-subdued border-l sc-border-firm pl-4 md:pl-5 mt-8" aria-label="Aside">
            {aside}
          </aside>
        </Reveal>
      )}
    </div>
  </div>
</section>
