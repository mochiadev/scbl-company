---
interface Props {
  tone?: 'dark' | 'light';
}

const { tone = 'dark' } = Astro.props;

const inputClass    = tone === 'light' ? 'sc-input-light'    : 'sc-input';
const textareaClass = tone === 'light' ? 'sc-textarea-light' : 'sc-textarea';
const optionBgClass = tone === 'light' ? 'sc-bg-ivory'       : 'sc-bg-canvas';
const submitBorderClass = tone === 'light' ? 'sc-border-hairline-light' : 'sc-border-soft';

const pillars = [
  { value: 'development',  label: 'Property Development' },
  { value: 'construction', label: 'Construction Services' },
  { value: 'engineering',  label: 'Engineering Services' },
  { value: 'real-estate',  label: 'Real Estate Services' },
  { value: 'management',   label: 'Project & Construction Management' },
  { value: 'specialist',   label: 'Specialist & Value-Added' },
];

const locations = [
  { value: 'ghana',    label: 'In Ghana' },
  { value: 'uk',       label: 'United Kingdom' },
  { value: 'us',       label: 'United States' },
  { value: 'canada',   label: 'Canada' },
  { value: 'other',    label: 'Elsewhere' },
];

const emailjsServiceId = import.meta.env.PUBLIC_EMAILJS_SERVICE_ID ?? '';
const emailjsTemplateId = import.meta.env.PUBLIC_EMAILJS_TEMPLATE_ID ?? '';
const emailjsPublicKey = import.meta.env.PUBLIC_EMAILJS_PUBLIC_KEY ?? '';

const pillarLabelMap = Object.fromEntries(pillars.map((p) => [p.value, p.label]));
const locationLabelMap = Object.fromEntries(locations.map((l) => [l.value, l.label]));
const instructionLabelMap: Record<string, string> = {
  sales: 'Sales & Marketing',
  leasing: 'Leasing & Tenant Rep',
  advisory: 'Investment Advisory',
  valuation: 'Valuation & Due Diligence',
};
---
<form
  id="form"
  data-sc-contact
  data-emailjs-service={emailjsServiceId}
  data-emailjs-template={emailjsTemplateId}
  data-emailjs-key={emailjsPublicKey}
  data-labels={JSON.stringify({ pillar: pillarLabelMap, location: locationLabelMap, instruction: instructionLabelMap })}
  class="grid gap-7"
  novalidate
>
  <div class="grid gap-6 md:grid-cols-2">
    <label class="flex flex-col gap-2">
      <span class="sc-caption sc-text-accent-subdued">Your name</span>
      <input type="text" name="name" required class={inputClass} placeholder="Full name" autocomplete="name" />
      <span class="sc-caption sc-text-muted hidden" data-sc-error="name">Please add your name.</span>
    </label>
    <label class="flex flex-col gap-2">
      <span class="sc-caption sc-text-accent-subdued">Email</span>
      <input type="email" name="email" required class={inputClass} placeholder="you@company.com" autocomplete="email" />
      <span class="sc-caption sc-text-muted hidden" data-sc-error="email">A valid email helps us reply.</span>
    </label>
  </div>

  <div class="grid gap-6 md:grid-cols-2">
    <label class="flex flex-col gap-2">
      <span class="sc-caption sc-text-accent-subdued">Where are you writing from?</span>
      <select name="from" class={inputClass}>
        <option value="" class={optionBgClass}>Select…</option>
        {locations.map((l) => (
          <option value={l.value} class={optionBgClass}>{l.label}</option>
        ))}
      </select>
    </label>
    <label class="flex flex-col gap-2">
      <span class="sc-caption sc-text-accent-subdued">Which pillar is your enquiry about?</span>
      <select name="pillar" required data-sc-pillar class={inputClass}>
        <option value="" class={optionBgClass}>Select a pillar…</option>
        {pillars.map((p) => (
          <option value={p.value} class={optionBgClass}>{p.label}</option>
        ))}
      </select>
    </label>
  </div>

  <div
    data-sc-conditional
    data-pillar="real-estate"
    class="hidden grid gap-6 md:grid-cols-2"
  >
    <label class="flex flex-col gap-2">
      <span class="sc-caption sc-text-accent-subdued">Instruction type</span>
      <select name="instruction" class={inputClass}>
        <option value="" class={optionBgClass}>Select…</option>
        <option value="sales" class={optionBgClass}>Sales & Marketing</option>
        <option value="leasing" class={optionBgClass}>Leasing & Tenant Rep</option>
        <option value="advisory" class={optionBgClass}>Investment Advisory</option>
        <option value="valuation" class={optionBgClass}>Valuation & Due Diligence</option>
      </select>
    </label>
    <label class="flex flex-col gap-2">
      <span class="sc-caption sc-text-accent-subdued">Ticket size (USD)</span>
      <input type="text" name="ticket" class={inputClass} placeholder="e.g. 5m–15m" />
    </label>
  </div>

  <label class="flex flex-col gap-2">
    <span class="sc-caption sc-text-accent-subdued">Tell us more</span>
    <textarea
      name="message"
      rows="5"
      required
      class={textareaClass}
      placeholder="Project location, size, budget range, timeline, sensitivities…"
    ></textarea>
    <span class="sc-caption sc-text-muted hidden" data-sc-error="message">A brief note lets us route your enquiry.</span>
  </label>

  <div class:list={[
    'flex flex-col md:flex-row items-start md:items-center justify-between gap-4 pt-6 border-t',
    submitBorderClass,
  ]}>
    <p class="sc-small sc-text-muted" data-sc-status role="status" aria-live="polite">
      Replies within one business day from the senior team.
    </p>
    <button type="submit" class="sc-btn-primary">Send enquiry</button>
  </div>
</form>

<script>
  import emailjs from '@emailjs/browser';

  const form = document.querySelector<HTMLFormElement>('[data-sc-contact]');
  const status = form?.querySelector<HTMLElement>('[data-sc-status]');
  const pillarSelect = form?.querySelector<HTMLSelectElement>('[data-sc-pillar]');
  const conditionals = form?.querySelectorAll<HTMLElement>('[data-sc-conditional]') ?? [];
  const labels = JSON.parse(form?.dataset.labels ?? '{"pillar":{},"location":{},"instruction":{}}');

  function syncConditional() {
    const value = pillarSelect?.value ?? '';
    conditionals.forEach((block) => {
      const raw = block.dataset.pillar ?? '';
      const allowed = raw.split(',').map((s) => s.trim());
      block.classList.toggle('hidden', !(value && allowed.includes(value)));
    });
  }
  pillarSelect?.addEventListener('change', syncConditional);
  syncConditional();

  // Inline validation on blur
  form?.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>('[required]').forEach((field) => {
    field.addEventListener('blur', () => {
      const errEl = form.querySelector<HTMLElement>(`[data-sc-error="${field.name}"]`);
      if (!errEl) return;
      const valid = field.checkValidity();
      errEl.classList.toggle('hidden', valid);
      field.style.borderBottomColor = valid ? '' : 'var(--sc-text-accent-subdued)';
    });
  });

  // Builds one pre-formatted block covering everything after name/email, so
  // the email template needs no conditional logic of its own — it just
  // prints this block as-is (real-estate-only fields are simply absent
  // for every other pillar).
  function buildDetails(data: Record<string, string>): string {
    const lines: string[] = [];
    lines.push(`Writing from: ${labels.location[data.from] ?? 'Not specified'}`);
    lines.push(`Enquiry about: ${labels.pillar[data.pillar] ?? data.pillar}`);
    if (data.pillar === 'real-estate') {
      if (data.instruction) lines.push(`Instruction type: ${labels.instruction[data.instruction] ?? data.instruction}`);
      if (data.ticket) lines.push(`Ticket size (USD): ${data.ticket}`);
    }
    lines.push('');
    lines.push('Message:');
    lines.push(data.message ?? '');
    return lines.join('\n');
  }

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!form.checkValidity()) {
      form.reportValidity();
      form.querySelectorAll<HTMLInputElement>('[required]').forEach((f) => f.dispatchEvent(new Event('blur')));
      return;
    }
    const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');
    button?.setAttribute('disabled', 'true');
    if (status) status.textContent = 'Sending…';

    const data = Object.fromEntries(new FormData(form).entries()) as Record<string, string>;
    const { emailjsService, emailjsTemplate, emailjsKey } = form.dataset;
    try {
      if (emailjsService && emailjsTemplate && emailjsKey) {
        await emailjs.send(
          emailjsService,
          emailjsTemplate,
          {
            from_name: data.name,
            from_email: data.email,
            details: buildDetails(data),
            submitted_at: new Date().toLocaleString('en-GB', { dateStyle: 'medium', timeStyle: 'short' }),
          },
          { publicKey: emailjsKey },
        );
      } else {
        console.log('[Signature Crest] Contact submission (EmailJS not configured):', data);
      }
      if (status) status.textContent = 'Enquiry received. We will be in touch within one business day.';
      form.reset();
      syncConditional();
    } catch (err) {
      if (status) status.textContent = 'Something went wrong. Please email signaturecrestbuilderslimited@gmail.com.';
      console.error(err);
    } finally {
      button?.removeAttribute('disabled');
    }
  });
</script>
