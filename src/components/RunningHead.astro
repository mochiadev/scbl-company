---
interface Props {
  code?: string;         // wordmark, e.g. "SCBL"
  rev?: string;          // optional middle slot; empty by default (avoid draft-sounding "REV 01")
  section?: string;      // e.g. "Portfolio" or "Services / Engineering"
  right?: string;        // optional right-side text, defaults to current year
  as?: 'div' | 'header';
  class?: string;
}

const {
  code = 'SCBL',
  rev = '',
  section = '',
  right,
  as: Tag = 'div',
  class: className = '',
} = Astro.props;

const rightText = right ?? new Date().getFullYear().toString();
const parts = [code, rev, section].filter(Boolean);
---
<Tag
  class:list={[
    'flex items-center justify-between gap-4 sc-slug sc-text-accent-subdued',
    'border-t border-b sc-border-chrome py-3',
    className,
  ]}
  aria-hidden="true"
>
  <span class="flex items-center gap-2 md:gap-3">
    {parts.map((p, i) => (
      <>
        <span>{p}</span>
        {i < parts.length - 1 && <span class="opacity-40">·</span>}
      </>
    ))}
  </span>
  <span class="opacity-70">{rightText}</span>
</Tag>
