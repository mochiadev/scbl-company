---
import { Icon } from 'astro-icon/components';

const nav = [
  { label: 'Practice',  href: '/about' },
  { label: 'Services',  href: '/services' },
  { label: 'Portfolio', href: '/portfolio' },
  { label: 'Insights',  href: '/insights' },
  { label: 'Contact',   href: '/contact' },
];
---
<header
  class="fixed top-0 left-0 right-0 z-50 sc-bg-elevated backdrop-blur-md border-b sc-border-chrome"
  data-sc-header
>
  <div class="sc-container sc-gutter flex items-center justify-between h-16 md:h-20">
    <a href="/" class="group flex items-center gap-3" aria-label="Signature Crest — home">
      <span class="sc-seal" aria-hidden="true">SC</span>
      <span class="font-display text-base md:text-lg sc-text-primary" style="font-variation-settings: 'opsz' 18;">
        Signature Crest
      </span>
    </a>

    <nav class="hidden md:flex items-center gap-8" aria-label="Primary">
      {nav.map((item, i) => (
        <a
          href={item.href}
          class="sc-small sc-text-secondary sc-link"
          data-index={String(i + 1).padStart(2, '0')}
        >
          {item.label}
        </a>
      ))}
      <a href="/contact#form" class="sc-btn-primary" style="padding: 0.6rem 1.2rem; min-height: auto;">
        Begin a project
      </a>
    </nav>

    <button
      type="button"
      class="md:hidden inline-flex items-center justify-center w-11 h-11 sc-text-primary sc-icon-btn"
      aria-label="Open menu"
      aria-expanded="false"
      data-sc-menu-toggle
    >
      <span class="sr-only">Menu</span>
      <Icon name="lucide:menu" class="w-6 h-6 sc-text-accent" data-icon-menu />
      <Icon name="lucide:x" class="w-6 h-6 sc-text-accent hidden" data-icon-close />
    </button>
  </div>

  <div
    class="md:hidden hidden border-t sc-border-chrome sc-bg-canvas"
    data-sc-menu-panel
    id="sc-mobile-menu"
  >
    <nav class="sc-container sc-gutter py-6" aria-label="Mobile primary">
      <p class="sc-slug sc-text-accent-subdued mb-6">SCBL · Directory</p>
      <ul class="flex flex-col divide-y divide-[color:var(--sc-border-chrome-dark)]">
        {nav.map((item, i) => (
          <li>
            <a
              href={item.href}
              class="flex items-center justify-between py-4 sc-text-primary hover:text-[color:var(--sc-text-accent-hover)] transition-colors"
            >
              <span class="font-display text-2xl" style="font-variation-settings: 'opsz' 24;">
                {item.label}
              </span>
              <span class="sc-slug sc-text-accent-subdued">{String(i + 1).padStart(2, '0')}</span>
            </a>
          </li>
        ))}
      </ul>
      <a href="/contact#form" class="sc-btn-primary mt-8 w-full justify-center">Begin a project</a>
    </nav>
  </div>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('[data-sc-menu-toggle]');
  const panel = document.querySelector<HTMLElement>('[data-sc-menu-panel]');
  const iconMenu = document.querySelector<HTMLElement>('[data-icon-menu]');
  const iconClose = document.querySelector<HTMLElement>('[data-icon-close]');

  function setOpen(open: boolean) {
    if (!toggle || !panel) return;
    toggle.setAttribute('aria-expanded', String(open));
    if (open) {
      panel.classList.remove('hidden');
      iconMenu?.classList.add('hidden');
      iconClose?.classList.remove('hidden');
    } else {
      panel.classList.add('hidden');
      iconMenu?.classList.remove('hidden');
      iconClose?.classList.add('hidden');
    }
  }

  toggle?.addEventListener('click', () => {
    const open = toggle.getAttribute('aria-expanded') === 'true';
    setOpen(!open);
  });

  // Close on route change
  document.addEventListener('astro:after-swap', () => setOpen(false));
</script>
