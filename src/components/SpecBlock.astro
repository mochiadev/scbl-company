---
interface Spec {
  label: string;
  value: string;
}
interface Props {
  specs: Spec[];
  heading?: string;
  compact?: boolean;
}
const { specs, heading = 'Technical Data', compact = false } = Astro.props;
---
<aside
  class:list={[
    'relative border sc-border-firm sc-bg-veil-60 backdrop-blur-sm',
    compact ? 'p-5' : 'p-6 md:p-7',
  ]}
  aria-label={heading}
>
  <p class="sc-bracket-label mb-5">{heading}</p>
  <dl class="divide-y divide-[color:var(--sc-border-soft-dark)]">
    {specs.map((s) => (
      <div class="grid grid-cols-5 gap-3 py-3">
        <dt class="sc-slug sc-text-muted col-span-2">{s.label}</dt>
        <dd class="tabular sc-small sc-text-primary col-span-3 text-right md:text-left">{s.value}</dd>
      </div>
    ))}
  </dl>
</aside>
