---
interface Props {
  title: string;
  slug: string;
  pillar: string;
  published: Date;
  reading_time: number;
  excerpt: string;
  variant?: 'row' | 'card';
}

const pillarLabels: Record<string, string> = {
  development: 'Development',
  construction: 'Construction',
  engineering: 'Engineering',
  'real-estate': 'Real Estate',
  management: 'Management',
  specialist: 'Specialist',
};

const { title, slug, pillar, published, reading_time, excerpt, variant = 'row' } = Astro.props;
const dateStr = published.toLocaleDateString('en-GB', {
  day: 'numeric',
  month: 'short',
  year: 'numeric',
});
---
{variant === 'row' ? (
  <a
    href={`/insights/${slug}`}
    class="group grid grid-cols-12 gap-6 md:gap-8 border-t sc-border-hairline py-7 md:py-8"
  >
    <div class="col-span-12 md:col-span-3">
      <p class="sc-slug sc-text-accent-subdued">{pillarLabels[pillar] ?? pillar}</p>
      <p class="sc-slug sc-text-muted mt-2 opacity-80">{reading_time} min · {dateStr}</p>
    </div>
    <div class="col-span-12 md:col-span-9">
      <h3 class="sc-heading-md sc-text-primary transition-colors duration-500 group-hover:text-[color:var(--sc-text-accent-hover)]">
        {title}
      </h3>
      <p class="sc-body sc-text-muted mt-3 max-w-[70ch]">{excerpt}</p>
      <span class="sc-small sc-text-accent sc-link inline-block mt-4">Read the note</span>
    </div>
  </a>
) : (
  <a
    href={`/insights/${slug}`}
    class="group flex flex-col justify-between border sc-border-soft p-6 md:p-7 min-h-[280px] transition-colors duration-500 hover:border-[color:var(--sc-border-accent)]"
  >
    <div>
      <p class="sc-slug sc-text-accent-subdued">
        {pillarLabels[pillar] ?? pillar} · {reading_time} min
      </p>
      <h3 class="sc-heading-md sc-text-primary mt-4 transition-colors duration-500 group-hover:text-[color:var(--sc-text-accent-hover)]">
        {title}
      </h3>
      <p class="sc-small sc-text-muted mt-3 leading-relaxed">{excerpt}</p>
    </div>
    <p class="sc-slug sc-text-accent-subdued mt-6">{dateStr}</p>
  </a>
)}
