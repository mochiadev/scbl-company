---
interface Props {
  opacity?: number;
}
const { opacity = 0.03 } = Astro.props;
---
<!--
  Warm-tinted noise (ivory tone) rather than pure white — reads as paper
  grain against the dark canvas instead of TV static.
-->
<div
  class="pointer-events-none fixed inset-0 z-[100] mix-blend-overlay"
  aria-hidden="true"
  style={`opacity:${opacity}`}
>
  <svg xmlns="http://www.w3.org/2000/svg" class="h-full w-full">
    <filter id="sc-noise">
      <feTurbulence type="fractalNoise" baseFrequency="0.9" numOctaves="2" stitchTiles="stitch" />
      <feColorMatrix
        values="0 0 0 0 0.972
                0 0 0 0 0.960
                0 0 0 0 0.941
                0 0 0 1 0" />
    </filter>
    <rect width="100%" height="100%" filter="url(#sc-noise)" />
  </svg>
</div>
