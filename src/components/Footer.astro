---
import { Icon } from 'astro-icon/components';
import { liveSocials } from '../lib/socials.ts';

const year = new Date().getFullYear();

const directory = [
  {
    heading: 'Practice',
    links: [
      { label: 'About',    href: '/about' },
      { label: 'Approach', href: '/about#approach' },
      { label: 'Values',   href: '/about#values' },
    ],
  },
  {
    heading: 'Services',
    links: [
      { label: 'Property Development',  href: '/services/development' },
      { label: 'Construction',          href: '/services/construction' },
      { label: 'Engineering',           href: '/services/engineering' },
      { label: 'Real Estate',           href: '/services/real-estate' },
      { label: 'Management',            href: '/services/management' },
      { label: 'Specialist',            href: '/services/specialist' },
    ],
  },
  {
    heading: 'Reference',
    links: [
      { label: 'Available Properties', href: '/available-properties' },
      { label: 'Insights',  href: '/insights' },
      { label: 'Contact',   href: '/contact' },
    ],
  },
];
---
<footer class="relative mt-24 md:mt-32 border-t sc-border-firm sc-bg-canvas sc-text-primary" data-sc-footer>
  <div class="sc-container sc-gutter py-16 md:py-20">

    <!-- Colophon head -->
    <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-8 mb-16">
      <div>
        <p class="sc-slug sc-text-accent-subdued mb-4">Signature Crest Builders Limited</p>
        <p class="sc-heading-lg max-w-md sc-text-primary">
          A single accountable practice. From feasibility through the fiftieth year of the asset.
        </p>
      </div>
      <div class="flex items-center gap-6 shrink-0">
        {liveSocials.length > 0 && (
          <ul class="flex items-center gap-4">
            {liveSocials.map((s) => (
              <li>
                <a
                  href={s.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={s.name}
                  class="sc-text-secondary hover:text-[color:var(--sc-text-accent-hover)] transition-colors"
                >
                  <Icon name={s.icon} class="w-5 h-5" />
                </a>
              </li>
            ))}
          </ul>
        )}
        <a href="/contact#form" class="sc-btn-secondary">Begin a project</a>
      </div>
    </div>

    <!-- Directory -->
    <div class="grid gap-10 md:gap-12 md:grid-cols-12">
      {directory.map((col) => (
        <div class="md:col-span-4">
          <p class="sc-caption sc-text-accent-subdued mb-4 uppercase" style="letter-spacing: 0.12em;">
            {col.heading}
          </p>
          <ul class="space-y-2 sc-small sc-text-secondary">
            {col.links.map((link) => (
              <li>
                <a href={link.href} class="sc-link hover:text-[color:var(--sc-text-accent-hover)]">
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <div class="hairline my-12" />

    <!-- Statutory / imprint -->
    <div class="grid gap-6 sc-small sc-text-muted md:grid-cols-3">
      <div>
        <p class="sc-slug sc-text-accent-subdued mb-2">Registered Office</p>
        <address class="not-italic leading-relaxed">
          Apolonia<br />
          Greater Accra, Ghana
        </address>
      </div>
      <div>
        <p class="sc-slug sc-text-accent-subdued mb-2">Correspondence</p>
        <p><a href="tel:+233500903792" class="sc-link">+233 500 903 792</a></p>
        <p><a href="mailto:signaturecrestbuilderslimited@gmail.com" class="sc-link">signaturecrestbuilderslimited@gmail.com</a></p>
      </div>
      <div class="md:text-right">
        <p class="sc-slug sc-text-accent-subdued mb-2">Imprint</p>
        <p>© {year} Signature Crest Builders Limited.</p>
        <p class="opacity-70">A Ghana-registered company.</p>
      </div>
    </div>
  </div>
</footer>
