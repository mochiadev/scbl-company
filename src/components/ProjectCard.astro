---
import { Image } from 'astro:assets';

interface Props {
  index?: number;                 // 01..NN — surfaced as a project record number
  title: string;
  slug: string;
  location: string;
  year: number;
  pillars: string[];
  image: string;
  imageAlt?: string;
  variant?: 'index' | 'card';     // index = editorial row, card = grid tile
  aspect?: 'landscape' | 'portrait' | 'square';
}

const pillarLabels: Record<string, string> = {
  development: 'Development',
  construction: 'Construction',
  engineering: 'Engineering',
  'real-estate': 'Real Estate',
  management: 'Management',
  specialist: 'Specialist',
};

const {
  index,
  title,
  slug,
  location,
  year,
  pillars,
  image,
  imageAlt,
  variant = 'index',
  aspect = 'landscape',
} = Astro.props;

const aspectClass = {
  landscape: 'aspect-[16/10]',
  portrait:  'aspect-[4/5]',
  square:    'aspect-square',
}[aspect];

const alt = imageAlt ?? `${title} — ${location}, ${year}`;
---
{variant === 'index' ? (
  <a
    href={`/portfolio/${slug}`}
    class="group grid grid-cols-12 gap-6 md:gap-8 border-t sc-border-hairline pt-8 md:pt-10"
  >
    <div class="col-span-12 md:col-span-4 flex flex-col justify-between">
      <div>
        {typeof index === 'number' && (
          <p class="sc-slug sc-text-accent-subdued">Record {String(index).padStart(2, '0')}</p>
        )}
        <h3 class="sc-heading-lg sc-text-primary mt-4 transition-colors duration-500 group-hover:text-[color:var(--sc-text-accent-hover)]">
          {title}
        </h3>
        <p class="sc-small sc-text-muted mt-3">{location} — {year}</p>
      </div>
      <p class="sc-caption sc-text-accent-subdued mt-6" style="letter-spacing: 0.14em;">
        {pillars.map((p) => pillarLabels[p] ?? p).join(' · ')}
      </p>
    </div>
    <div class:list={['col-span-12 md:col-span-8 relative overflow-hidden', aspectClass]}>
      <Image
        src={image}
        alt={alt}
        width={1600}
        height={aspect === 'portrait' ? 2000 : aspect === 'square' ? 1600 : 1000}
        widths={[600, 900, 1200, 1600]}
        sizes="(min-width: 768px) 66vw, 100vw"
        class="h-full w-full object-cover transition-transform duration-[1400ms] ease-out group-hover:scale-[1.03]"
        format="webp"
      />
      <div class="absolute inset-0 sc-overlay-image-bottom-to-top"></div>
    </div>
  </a>
) : (
  <a href={`/portfolio/${slug}`} class="group block">
    <div class:list={['relative overflow-hidden', aspectClass]}>
      <Image
        src={image}
        alt={alt}
        width={1600}
        height={aspect === 'portrait' ? 2000 : aspect === 'square' ? 1600 : 1000}
        widths={[600, 900, 1200, 1600]}
        sizes="(min-width: 768px) 45vw, 100vw"
        class="h-full w-full object-cover transition-transform duration-[1400ms] ease-out group-hover:scale-[1.03]"
        format="webp"
      />
      <div class="absolute inset-0 sc-overlay-image-bottom-to-top"></div>
    </div>
    <div class="pt-5">
      {typeof index === 'number' && (
        <p class="sc-slug sc-text-accent-subdued">Record {String(index).padStart(2, '0')}</p>
      )}
      <h3 class="sc-heading-md sc-text-primary mt-2 transition-colors duration-500 group-hover:text-[color:var(--sc-text-accent-hover)]">
        {title}
      </h3>
      <p class="sc-small sc-text-muted mt-2">{location} — {year}</p>
      <p class="sc-caption sc-text-accent-subdued mt-2" style="letter-spacing: 0.14em;">
        {pillars.map((p) => pillarLabels[p] ?? p).join(' · ')}
      </p>
    </div>
  </a>
)}
