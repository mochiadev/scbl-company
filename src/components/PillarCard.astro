---
import { Icon } from 'astro-icon/components';

interface Props {
  eyebrow: string;
  title: string;
  href: string;
  icon: string;
  span?: 'sm' | 'md' | 'lg';
  tone?: 'navy' | 'ivory';
  subServices?: string[];
}

const {
  eyebrow,
  title,
  href,
  icon,
  span = 'md',
  tone = 'navy',
  subServices = [],
} = Astro.props;

const spanMap = {
  sm: 'md:col-span-4 md:row-span-1',
  md: 'md:col-span-6 md:row-span-1',
  lg: 'md:col-span-8 md:row-span-2',
} as const;

const surfaceClass = tone === 'ivory' ? 'sc-card-ivory' : 'sc-card-dark';
const eyebrowClass = tone === 'ivory' ? 'sc-text-accent-subdued' : 'sc-text-accent';
---
<a
  href={href}
  class:list={[
    'group relative flex flex-col justify-between overflow-hidden p-8 transition-all duration-500',
    surfaceClass,
    spanMap[span],
  ]}
>
  <div class="pointer-events-none absolute right-6 top-6 opacity-10 transition-opacity duration-500 group-hover:opacity-25">
    <Icon name={icon} class="h-24 w-24 sc-text-accent" />
  </div>

  <div class="relative">
    <p class:list={['tabular text-[11px]', eyebrowClass]}>{eyebrow}</p>
    <h3 class="mt-4 font-display text-2xl leading-tight md:text-3xl">
      {title}
    </h3>
  </div>

  {subServices.length > 0 && span === 'lg' && (
    <ul class="relative mt-8 space-y-2 text-sm sc-text-muted">
      {subServices.slice(0, 4).map((s) => (
        <li class="flex items-center gap-3">
          <span class="h-px w-4 bg-[color:var(--sc-accent-divider)]"></span>
          {s}
        </li>
      ))}
    </ul>
  )}

  <div class="relative mt-10 flex items-center justify-between">
    <span class="text-xs uppercase tracking-widest sc-text-muted">Explore</span>
    <span class="sc-text-accent transition-transform duration-500 group-hover:translate-x-2 group-hover:text-[color:var(--sc-text-accent-hover)]">→</span>
  </div>
</a>
