---
import { Icon } from 'astro-icon/components';

interface Props {
  index: number;                 // 1..6 — pillar ordinal in the practice
  title: string;
  href: string;
  icon: string;
  tone?: 'navy' | 'ivory';
  short?: string;                // one-line description
  subServices?: string[];        // inline chips, top 2 rendered
  emphasis?: 'lead' | 'standard';
}

const {
  index,
  title,
  href,
  icon,
  tone = 'navy',
  short,
  subServices = [],
  emphasis = 'standard',
} = Astro.props;

const surfaceClass = tone === 'ivory' ? 'sc-card-ivory' : 'sc-card-dark';
const slugClass    = tone === 'ivory' ? 'sc-text-accent-subdued' : 'sc-text-accent-subdued';
const mutedClass   = tone === 'ivory' ? 'sc-text-muted' : 'sc-text-muted';
const chipBorder   = tone === 'ivory' ? 'sc-border-hairline-light' : 'sc-border-hairline';
---
<a
  href={href}
  class:list={[
    'group relative flex flex-col justify-between overflow-hidden transition-colors duration-500',
    'p-6 md:p-8',
    emphasis === 'lead' ? 'min-h-[22rem] md:min-h-[26rem]' : 'min-h-[18rem]',
    surfaceClass,
  ]}
>
  <div class="pointer-events-none absolute right-4 top-4 opacity-15 transition-opacity duration-500 group-hover:opacity-30">
    <Icon name={icon} class="h-16 w-16 md:h-20 md:w-20 sc-text-accent" />
  </div>

  <header class="relative">
    <p class:list={['sc-slug', slugClass]}>
      Pillar {String(index).padStart(2, '0')} — {title.split(' ').slice(-1)[0]}
    </p>
    <h3 class:list={['mt-4', emphasis === 'lead' ? 'sc-heading-lg' : 'sc-heading-md']}>
      {title}
    </h3>
    {short && (
      <p class:list={['mt-4 max-w-[42ch] sc-body', mutedClass]}>{short}</p>
    )}
  </header>

  <footer class="relative mt-8 flex flex-wrap items-end justify-between gap-4">
    <ul class="flex flex-wrap gap-2">
      {subServices.slice(0, emphasis === 'lead' ? 3 : 2).map((s) => (
        <li class:list={['sc-caption px-2.5 py-1 border', chipBorder, mutedClass]}>
          {s}
        </li>
      ))}
    </ul>
    <span class="sc-small sc-text-accent sc-link">Read the pillar</span>
  </footer>
</a>
