---
interface Props {
  position?: 'top-left' | 'top-right' | 'center' | 'bottom-left' | 'bottom-right';
  size?: 'md' | 'lg' | 'xl';
  intensity?: number;   // 0..1 — default very soft; the Ledger prefers restraint
}
const { position = 'top-right', size = 'lg', intensity = 0.06 } = Astro.props;

const positionMap = {
  'top-left':     'top-[-12%] left-[-8%]',
  'top-right':    'top-[-12%] right-[-8%]',
  'center':       'top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2',
  'bottom-left':  'bottom-[-15%] left-[-10%]',
  'bottom-right': 'bottom-[-15%] right-[-10%]',
} as const;
const sizeMap = {
  md: 'h-[32rem] w-[32rem]',
  lg: 'h-[48rem] w-[48rem]',
  xl: 'h-[64rem] w-[64rem]',
} as const;
---
<div
  class:list={[
    'pointer-events-none absolute -z-0 rounded-full blur-[140px]',
    positionMap[position],
    sizeMap[size],
  ]}
  style={`background: radial-gradient(closest-side, color-mix(in oklab, var(--color-sc-gold) ${Math.round(intensity * 100)}%, transparent), transparent 72%);`}
  aria-hidden="true"
/>
